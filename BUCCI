-- ============================================
-- ARRASTRE COMPATIBLE CON FRAME Y BOTONES
-- ============================================
-- Frame no tiene MouseButton1Down. El arrastre debe hacerse mediante
-- InputBegan/InputChanged y UserInputService.
local function hacerMovibleConBoton(objeto)
    if not objeto or not objeto:IsA("GuiObject") then return end

    objeto.Active = true
    local userInputService = game:GetService("UserInputService")
    local arrastrando = false
    local entradaArrastre
    local posicionInicial
    local posicionObjeto

    objeto.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            arrastrando = true
            entradaArrastre = input
            posicionInicial = input.Position
            posicionObjeto = objeto.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    arrastrando = false
                end
            end)
        end
    end)

    objeto.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            entradaArrastre = input
        end
    end)

    userInputService.InputChanged:Connect(function(input)
        if input == entradaArrastre and arrastrando then
            local delta = input.Position - posicionInicial
            objeto.Position = UDim2.new(
                posicionObjeto.X.Scale,
                posicionObjeto.X.Offset + delta.X,
                posicionObjeto.Y.Scale,
                posicionObjeto.Y.Offset + delta.Y
            )
        end
    end)
end

