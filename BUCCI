local function restaurarNoclip()
    noclipActivo = false
    if noclipConexion then
        pcall(function() noclipConexion:Disconnect() end)
        noclipConexion = nil
    end
    for parte, colision in pairs(noclipOriginal) do
        if parte and parte.Parent then
            pcall(function() parte.CanCollide = colision end)
        end
    end
    noclipOriginal = {}
end

local function alternarNoclip()
    if noclipActivo then
        restaurarNoclip()
        return false
    end

    noclipActivo = true
    noclipConexion = game:GetService("RunService").Stepped:Connect(function()
        if not noclipActivo then return end
        local char = player.Character
        if not char then return end
        for _, parte in ipairs(char:GetDescendants()) do
            if parte:IsA("BasePart") then
                if noclipOriginal[parte] == nil then
                    noclipOriginal[parte] = parte.CanCollide
                end
                parte.CanCollide = false
            end
        end
    end)
    return true
end

local function detenerVuelo()
    vueloActivo = false
    if vueloConexion then
        pcall(function() vueloConexion:Disconnect() end)
        vueloConexion = nil
    end
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if humanoid then humanoid.PlatformStand = false end
    if root then
        for _, objeto in ipairs(root:GetChildren()) do
            if objeto:IsA("BodyVelocity") or objeto:IsA("BodyGyro") then
                objeto:Destroy()
            end
        end
    end
end

local function alternarVuelo()
    if vueloActivo then
        detenerVuelo()
        return false
    end

    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return false end

    local userInputService = game:GetService("UserInputService")
    local camera = workspace.CurrentCamera
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.Velocity = Vector3.zero
    bodyVelocity.Parent = root

    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P = 90000
    bodyGyro.CFrame = root.CFrame
    bodyGyro.Parent = root

    vueloActivo = true
    humanoid.PlatformStand = true
    vueloConexion = game:GetService("RunService").RenderStepped:Connect(function()
        if not vueloActivo or not root.Parent then
            detenerVuelo()
            return
        end

        local direccion = Vector3.zero
        if userInputService:IsKeyDown(Enum.KeyCode.W) then direccion = direccion + camera.CFrame.LookVector end
        if userInputService:IsKeyDown(Enum.KeyCode.S) then direccion = direccion - camera.CFrame.LookVector end
        if userInputService:IsKeyDown(Enum.KeyCode.A) then direccion = direccion - camera.CFrame.RightVector end
        if userInputService:IsKeyDown(Enum.KeyCode.D) then direccion = direccion + camera.CFrame.RightVector end
        if userInputService:IsKeyDown(Enum.KeyCode.Space) then direccion = direccion + Vector3.new(0, 1, 0) end
        if userInputService:IsKeyDown(Enum.KeyCode.LeftShift) then direccion = direccion - Vector3.new(0, 1, 0) end

        bodyVelocity.Velocity = direccion.Magnitude > 0 and direccion.Unit * vueloVelocidad or Vector3.zero
        bodyGyro.CFrame = camera.CFrame
    end)
    return true
end

