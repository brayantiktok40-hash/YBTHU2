-- ============================================
-- ESP FULL (MÓDULO AISLADO: SOLO HUEVOS)
-- No modifica las funciones anteriores del script.
-- Marca únicamente objetos cuyo nombre contiene egg/huevo.
-- Lee atributos, valores y textos del huevo para mostrar recompensa y dinero.
-- ============================================
do
    local espFullActivo = false
    local espFullGui = nil
    local espFullConexion = nil
    local espFullMarcadores = {}

    local function espFullContenedor()
        if type(gethui) == "function" then
            local ok, hui = pcall(gethui)
            if ok and hui then return hui end
        end
        local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
        if ok and coreGui then return coreGui end
        return player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
    end

    local function espFullTexto(valor)
        if valor == nil then return nil end
        local texto = tostring(valor)
        if texto == "" then return nil end
        return texto
    end

    local function espFullBuscar(objeto, nombres)
        for _, nombre in ipairs(nombres) do
            local ok, atributo = pcall(function() return objeto:GetAttribute(nombre) end)
            if ok and atributo ~= nil then
                return espFullTexto(atributo)
            end
            local hijo = objeto:FindFirstChild(nombre, true)
            if hijo then
                if hijo:IsA("StringValue") or hijo:IsA("NumberValue") or hijo:IsA("IntValue") or hijo:IsA("BoolValue") then
                    return espFullTexto(hijo.Value)
                end
                local texto = hijo:FindFirstChildWhichIsA("TextLabel", true)
                if texto then return espFullTexto(texto.Text) end
            end
        end
        return nil
    end

    local function espFullEsHuevo(objeto)
        local nombre = string.lower(objeto.Name or "")
        return string.find(nombre, "egg", 1, true) ~= nil
            or string.find(nombre, "huevo", 1, true) ~= nil
    end

    local function espFullParte(objeto)
        if objeto:IsA("BasePart") then return objeto end
        if objeto:IsA("Model") then
            if objeto.PrimaryPart then return objeto.PrimaryPart end
            return objeto:FindFirstChildWhichIsA("BasePart", true)
        end
        return objeto:FindFirstAncestorWhichIsA("BasePart")
    end

    local function espFullRecompensa(objeto)
        return espFullBuscar(objeto, {"Reward", "Rewards", "Contenido", "Contents", "Item", "Pet", "Mascota", "Drop", "Result", "Resultado"}) or "No definido"
    end

    local function espFullDinero(objeto)
        local nombresDirectos = {
            "Money", "Cash", "Coins", "Coin", "Dinero", "RewardAmount", "MoneyReward",
            "CashReward", "CoinReward", "Payout", "Earnings", "Ganancia"
        }

        -- Busca primero en el huevo y en el modelo que lo contiene.
        local fuente = objeto
        local modelo = objeto:FindFirstAncestorWhichIsA("Model")
        if modelo then fuente = modelo end

        local function dineroValido(valor)
            if valor == nil then return nil end

            local texto = tostring(valor)
            -- Nunca uses una etiqueta descriptiva (por ejemplo, "sleep") como dinero.
            -- Solo se acepta una cantidad numérica, con separadores opcionales.
            local numero = string.match(texto, "%d[%d%.,]*")
            if not numero then return nil end

            local normalizado = string.gsub(numero, "[,%.]", "")
            if normalizado == "" or tonumber(normalizado) == 0 then
                return nil
            end

            return numero
        end

        local directo = dineroValido(espFullBuscar(fuente, nombresDirectos))
        if directo then return directo end

        -- Revisa atributos cuyo nombre indique una recompensa monetaria.
        for nombre, valor in pairs(fuente:GetAttributes()) do
            local nombreBajo = string.lower(tostring(nombre))
            if string.find(nombreBajo, "money", 1, true)
                or string.find(nombreBajo, "cash", 1, true)
                or string.find(nombreBajo, "coin", 1, true)
                or string.find(nombreBajo, "dinero", 1, true)
                or string.find(nombreBajo, "payout", 1, true)
                or string.find(nombreBajo, "earn", 1, true) then
                local texto = dineroValido(espFullTexto(valor))
                if texto then return texto end
            end
        end

        -- Algunos juegos guardan el pago en un atributo de una pieza interna.
        for _, descendiente in ipairs(fuente:GetDescendants()) do
            for nombre, valor in pairs(descendiente:GetAttributes()) do
                local nombreBajo = string.lower(tostring(nombre))
                if string.find(nombreBajo, "money", 1, true)
                    or string.find(nombreBajo, "cash", 1, true)
                    or string.find(nombreBajo, "coin", 1, true)
                    or string.find(nombreBajo, "dinero", 1, true)
                    or string.find(nombreBajo, "payout", 1, true)
                    or string.find(nombreBajo, "earn", 1, true) then
                    local texto = dineroValido(espFullTexto(valor))
                    if texto then return texto end
                end
            end
        end

        -- Revisa valores y etiquetas dentro del modelo del huevo.
        for _, hijo in ipairs(fuente:GetDescendants()) do
            local nombreBajo = string.lower(hijo.Name or "")
            local esDinero = string.find(nombreBajo, "money", 1, true)
                or string.find(nombreBajo, "cash", 1, true)
                or string.find(nombreBajo, "coin", 1, true)
                or string.find(nombreBajo, "dinero", 1, true)
                or string.find(nombreBajo, "payout", 1, true)
                or string.find(nombreBajo, "earn", 1, true)

            if esDinero and (hijo:IsA("StringValue") or hijo:IsA("NumberValue")
                or hijo:IsA("IntValue") or hijo:IsA("BoolValue")) then
                local texto = dineroValido(espFullTexto(hijo.Value))
                if texto then return texto end
            end

            if hijo:IsA("TextLabel") or hijo:IsA("TextButton") then
                local texto = tostring(hijo.Text or "")
                local textoBajo = string.lower(texto)
                if string.find(texto, "$", 1, true)
                    or string.find(textoBajo, "money", 1, true)
                    or string.find(textoBajo, "cash", 1, true)
                    or string.find(textoBajo, "coins", 1, true)
                    or string.find(textoBajo, "dinero", 1, true) then
                    local dinero = dineroValido(texto)
                    if dinero then return dinero end
                end
            end
        end

        return "No detectado"
    end

    local function espFullCrearMarcador(objeto)
        if espFullMarcadores[objeto] or not objeto.Parent then return end
        local parte = espFullParte(objeto)
        if not parte then return end

        local marcador = Instance.new("BillboardGui")
        marcador.Name = "ESP_FULL_EggMarker"
        marcador.Adornee = parte
        marcador.AlwaysOnTop = true
        marcador.Size = UDim2.new(0, 240, 0, 74)
        marcador.StudsOffset = Vector3.new(0, 3.5, 0)
        marcador.MaxDistance = 500
        marcador.Parent = espFullContenedor()

        local fondo = Instance.new("Frame")
        fondo.Size = UDim2.fromScale(1, 1)
        fondo.BackgroundColor3 = Color3.fromRGB(10, 10, 25)
        fondo.BackgroundTransparency = 0.12
        fondo.BorderSizePixel = 1
        fondo.BorderColor3 = Color3.fromRGB(255, 200, 0)
        fondo.Parent = marcador

        local esquina = Instance.new("UICorner")
        esquina.CornerRadius = UDim.new(0, 8)
        esquina.Parent = fondo

        local texto = Instance.new("TextLabel")
        texto.Name = "ESP_FULL_Info"
        texto.Size = UDim2.new(1, -10, 1, -8)
        texto.Position = UDim2.new(0, 5, 0, 4)
        texto.BackgroundTransparency = 1
        texto.TextColor3 = Color3.fromRGB(255, 255, 255)
        texto.TextStrokeTransparency = 0.35
        texto.TextSize = 13
        texto.Font = Enum.Font.GothamBold
        texto.TextWrapped = true
        texto.Text = "🥚 " .. objeto.Name .. "\nAparece: " .. espFullRecompensa(objeto) .. "\nDinero: " .. espFullDinero(objeto)
        texto.Parent = fondo

        espFullMarcadores[objeto] = {gui = marcador, texto = texto}
    end

    local function espFullEliminarMarcadores()
        for objeto, datos in pairs(espFullMarcadores) do
            if datos.gui then pcall(function() datos.gui:Destroy() end) end
            espFullMarcadores[objeto] = nil
        end
    end

    local espFullProximaActualizacion = 0
    local espFullIntervalo = 0.75

    local function espFullActualizar()
        if not espFullActivo then return end

        -- Heartbeat sigue activo, pero el escaneo pesado solo ocurre cada 0.75 s.
        local ahora = os.clock()
        if ahora < espFullProximaActualizacion then return end
        espFullProximaActualizacion = ahora + espFullIntervalo

        for _, candidato in ipairs(workspace:GetDescendants()) do
            if espFullEsHuevo(candidato) then
                -- Si el huevo tiene piezas internas con nombres que también contienen
                -- "egg", usa el modelo más cercano para crear un solo marcador.
                local objeto = candidato:FindFirstAncestorWhichIsA("Model") or candidato
                espFullCrearMarcador(objeto)
                local datos = espFullMarcadores[objeto]
                if datos and datos.texto then
                    local dinero = espFullDinero(objeto)
                    datos.texto.Text = "🥚 " .. objeto.Name
                        .. "\nAparece: " .. espFullRecompensa(objeto)
                        .. "\nDinero: " .. dinero
                end
            end
        end

        for objeto, datos in pairs(espFullMarcadores) do
            if not objeto.Parent then
                if datos.gui then datos.gui:Destroy() end
                espFullMarcadores[objeto] = nil
            end
        end
    end

    local function espFullAlternar()
        espFullActivo = not espFullActivo
        if espFullActivo then
            espFullProximaActualizacion = 0
            espFullActualizar()
            if espFullConexion then pcall(function() espFullConexion:Disconnect() end) end
            espFullConexion = game:GetService("RunService").Heartbeat:Connect(function()
                espFullActualizar()
            end)
        else
            if espFullConexion then pcall(function() espFullConexion:Disconnect() end) end
            espFullConexion = nil
            espFullEliminarMarcadores()
        end
    end

    task.spawn(function()
        local espera = 0
        while not guiPrincipal and espera < 120 do
            task.wait(0.25)
            espera = espera + 0.25
        end
        if not guiPrincipal then return end

        local contenedor = guiPrincipal:FindFirstChildWhichIsA("Frame")
        if not contenedor then return end
        local contenido = contenedor:FindFirstChildWhichIsA("Frame")
        if not contenido then return end

        local botonESP = Instance.new("TextButton")
        botonESP.Name = "ESP_FULL_Button"
        botonESP.Size = UDim2.new(0.9, 0, 0, 45)
        botonESP.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        botonESP.BorderSizePixel = 0
        botonESP.Text = "🥚 ESP FULL: OFF"
        botonESP.TextColor3 = Color3.fromRGB(255, 255, 255)
        botonESP.TextSize = 15
        botonESP.Font = Enum.Font.GothamBold
        botonESP.LayoutOrder = 2.5
        botonESP.Parent = contenido

        local esquina = Instance.new("UICorner")
        esquina.CornerRadius = UDim.new(0, 8)
        esquina.Parent = botonESP

        botonESP.MouseButton1Click:Connect(function()
            espFullAlternar()
            if espFullActivo then
                botonESP.Text = "🥚 ESP FULL: ON"
                botonESP.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
            else
                botonESP.Text = "🥚 ESP FULL: OFF"
                botonESP.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
            end
        end)
    end)
end
