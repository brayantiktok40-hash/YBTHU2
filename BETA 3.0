    ES = { Title = "YBTHU", Sub = "BETA 3.0 PRO", Combat = "COMBATE", Visuals = "VISUALES", Misc = "AJUSTES", Aim = "Aimbot", Silent = "Silent Aim", Trigger = "Triggerbot", Rage = "Rage Aim", Ban = "⚠ BAN", Hit = "HitChance", Esp = "ESP", Skin = "Skin Changer", Fov = "FOV Circle", Part = "Target Part", Color = "ESP Color", Lang = "Idioma", Disc = "Discord", Kill = "APAGAR SCRIPT", Notify = "Link copiado", Credit = "Creado por Brayan (YBTHU)" },
