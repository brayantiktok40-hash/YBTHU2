local Runtime = getgenv and getgenv() or _G
local INSTANCE_TOKEN = tostring(os.clock()) .. tostring(math.random(100000, 999999))
Runtime.__YBTHU_BETA3_TOKEN = INSTANCE_TOKEN

local running = true
local allConnections = {}
local screenGuiRef = nil
local fovGuiRef = nil

local function safeConnect(signal, fn)
    local conn = signal:Connect(fn)
    table.insert(allConnections, conn)
    return conn
end

local Settings = {
    -- Core combat
    Aimbot = true,
    SilentAim = true,
    Rage = false,
    AimKey = Enum.UserInputType.MouseButton2,
    FOV = 360,
    RageFOV = 650,
    ShowFOV = true,
    MaxDistance = 550,
    TargetPart = "Head",
    Smoothness = 0.42,
    AimDeadzone = 4.5,
    SilentSmoothness = 0.78,
    RageSmoothness = 0.97,
    Prediction = 0.135,
    MouseAccel = 0.96,
    TargetRefresh = 0.045,
    WallCheck = false,
    IgnoreTeam = true,
    StickyAim = true,
    -- Visuals
    ESP = true,
    ColorIndex = 1,
    -- UI
    Language = "ES",
    MenuKey = Enum.KeyCode.Insert,
    Visible = true,
    AutoFireRate = 0.12,

    ESPColors = {
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(255, 70, 70),
        Color3.fromRGB(70, 255, 120),
        Color3.fromRGB(70, 150, 255),
        Color3.fromRGB(255, 200, 50),
    },
    ColorNames = {
        ES = {"Blanco", "Rojo", "Verde", "Azul", "Dorado"},
        EN = {"White", "Red", "Green", "Blue", "Gold"},
    },
    PartNames = {
        ES = { Head = "Cabeza", UpperTorso = "Torso", HumanoidRootPart = "Root" },
        EN = { Head = "Head", UpperTorso = "Torso", HumanoidRootPart = "Root" },
    },
}

local pbSavedCFrame = nil
local pbUntil = 0
local pbBusy = false
local lastPB = 0

local function killScript()
    if running == false then return end
    running = false
    Settings.Aimbot = false
    Settings.SilentAim = false
    Settings.Rage = false
    Settings.ESP = false
    Settings.ShowFOV = false
    for i = 1, #allConnections do
        local c = allConnections[i]
        if c then pcall(function() c:Disconnect() end) end
    end
    for i = #allConnections, 1, -1 do allConnections[i] = nil end
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            if char then
                for _, ch in ipairs(char:GetChildren()) do
                    if ch:IsA("Highlight") then pcall(function() ch:Destroy() end) end
                end
            end
        end
    end)
    pcall(function() if fovGuiRef then fovGuiRef:Destroy() end end)
    pcall(function() if screenGuiRef then screenGuiRef:Destroy() end end)
    local names = {"YBTHU_BETA3", "YBTHU_FOV"}
    local parents = {}
    pcall(function() if typeof(gethui) == "function" then local h = gethui() if h then table.insert(parents, h) end end end)
    pcall(function() table.insert(parents, game:GetService("CoreGui")) end)
    pcall(function() local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") if pg then table.insert(parents, pg) end end)
    for _, parent in ipairs(parents) do
        for _, name in ipairs(names) do
            pcall(function() local obj = parent:FindFirstChild(name) if obj then obj:Destroy() end end)
        end
    end
    pcall(function() StarterGui:SetCore("SendNotification", { Title = "YBTHU", Text = "Script APAGADO", Duration = 3 }) end)
    pcall(function() RunService:UnbindFromRenderStep("YBTHU_SilentRivals_B3") end)
    pcall(function() RunService:UnbindFromRenderStep("YBTHU_SilentRivals") end)
    pcall(function()
        if pbSavedCFrame then
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then root.CFrame = pbSavedCFrame end
        end
        pbSavedCFrame = nil
        pbBusy = false
    end)
    print("[YBTHU BETA 3.0] Script completamente apagado")
end

local Texts = {
    ES = { Title = "YBTHU", Sub = "BETA 3.0 PRO", Combat = "COMBATE", Visuals = "VISUALES", Misc = "AJUSTES", Aim = "Aimbot", Silent = "Silent Aim", Rage = "Rage Aim", Esp = "ESP", Fov = "FOV Circle", Part = "Target Part", Color = "ESP Color", Lang = "Idioma", Disc = "Discord", Kill = "APAGAR SCRIPT", Notify = "Link copiado", Credit = "Creado por Brayan (YBTHU) • BETA 3.0" },
    EN = { Title = "YBTHU", Sub = "BETA 3.0 PRO", Combat = "COMBAT", Visuals = "VISUALS", Misc = "SETTINGS", Aim = "Aimbot", Silent = "Silent Aim", Rage = "Rage Aim", Esp = "ESP", Fov = "FOV Circle", Part = "Target Part", Color = "ESP Color", Lang = "Language", Disc = "Discord", Kill = "KILL SCRIPT", Notify = "Link copied", Credit = "Created by Brayan (YBTHU) • BETA 3.0" },
}

local DISCORD_URL = "https://discord.gg/b9mvbR6rq"
local PART_CYCLE = { "Head", "UpperTorso", "HumanoidRootPart" }
local partIndex = 1

local Theme = {
    Bg = Color3.fromRGB(18, 18, 24), Header = Color3.fromRGB(24, 24, 32), Card = Color3.fromRGB(28, 28, 38),
    Accent = Color3.fromRGB(255, 200, 50), Text = Color3.fromRGB(240, 240, 245), TextDim = Color3.fromRGB(140, 140, 155),
    On = Color3.fromRGB(50, 200, 120), Off = Color3.fromRGB(55, 55, 70), Rage = Color3.fromRGB(220, 50, 50),
    Stroke = Color3.fromRGB(45, 45, 60), Discord = Color3.fromRGB(88, 101, 242),
}

local function getGuiParent()
    if typeof(gethui) == "function" then local ok, hui = pcall(gethui) if ok and hui then return hui end end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
end

local function notify(title, text, duration)
    pcall(function() StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration or 4 }) end)
end

notify("YBTHU", Texts[Settings.Language].Credit, 5)

local function getPart(character)
    if not character then return nil end
    if Settings.Rage then return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") end
    return character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if Settings.IgnoreTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
    return isAlive(player.Character)
end

local function hasLineOfSight(fromPos, toPart, character)
    if Settings.Rage or not Settings.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { Camera }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function getPredictedPosition(part)
    if not part then return nil end
    local pred = Settings.Rage and (Settings.Prediction + 0.14) or Settings.Prediction
    if pred <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function()
        local char = part.Parent
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        local src = root or part
        velocity = src.AssemblyLinearVelocity or src.Velocity or Vector3.zero
    end)
    return part.Position + Vector3.new(velocity.X, velocity.Y * 0.25, velocity.Z) * pred
end

local function getActiveFOV()
    return Settings.Rage and Settings.RageFOV or Settings.FOV
end

local currentTarget, stickyTarget = nil, nil
local silentAimPos = nil
local aiming = false
local lastScan = 0
local targetRefreshRate = Settings.TargetRefresh or 0.055
local smoothedAimPosition = nil
local smoothedTarget = nil
local silentSnapUntil = 0

local function getClosestTarget()
    local fov = getActiveFOV()
    local closest, closestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    if Settings.StickyAim and stickyTarget and stickyTarget.Parent then
        local char = stickyTarget:FindFirstAncestorOfClass("Model") or stickyTarget.Parent
        local player = typeof(char) == "Instance" and char:IsA("Model") and Players:GetPlayerFromCharacter(char)
        local withinDistance = (camPos - stickyTarget.Position).Magnitude <= Settings.MaxDistance
        if player and withinDistance and isValidPlayer(player) then
            local sp, onScreen = Camera:WorldToViewportPoint(stickyTarget.Position)
            if onScreen and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                local stickyMul = Settings.Rage and 1.8 or 1.35
                if dist <= fov * stickyMul and hasLineOfSight(camPos, stickyTarget, char) then return stickyTarget end
            end
        end
        stickyTarget = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local character = player.Character
            local part = getPart(character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end
    stickyTarget = closest
    return closest
end

local function doPointBlankWallbang()
    if not Settings.Rage or not running then return end
    if tick() - lastPB < 0.18 then return end
    local target = currentTarget
    if not target or not target.Parent then
        target = getClosestTarget()
        currentTarget = target
    end
    if not target or not target.Parent then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local tpos = target.Position
    if pbBusy and pbSavedCFrame then
        pbUntil = tick() + 0.14
        lastPB = tick()
        return
    end

    pbBusy = true
    lastPB = tick()
    local ok = pcall(function()
        pbSavedCFrame = root.CFrame
        local dir = (root.Position - tpos)
        if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) end
        dir = dir.Unit
        local nearPos = tpos + dir * 2.2 + Vector3.new(0, 1.2, 0)
        root.CFrame = CFrame.new(nearPos, tpos)
        pbUntil = tick() + 0.14
    end)
    if not ok then
        pbBusy = false
        pbSavedCFrame = nil
    end
end

local function restorePointBlank()
    if not pbSavedCFrame then
        pbBusy = false
        return
    end
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and pbSavedCFrame then
            root.CFrame = pbSavedCFrame
        end
    end)
    pbSavedCFrame = nil
    pbBusy = false
end

local function rivalsSilentActive()
    if not running or not Settings.SilentAim then return false end
    if Settings.Rage then return true end
    local ok = aiming
    pcall(function()
        if UserInputService:IsMouseButtonPressed(Settings.AimKey) then ok = true end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then ok = true end
    end)
    if tick() < silentSnapUntil then ok = true end
    return ok
end

-- Silent Aim optimizado para Rivals: fuerza el lookAt en prioridad de cámara

safeConnect(UserInputService.InputBegan, function(input, gp)
    if gp or not running then return end
    if input.UserInputType == Settings.AimKey then aiming = true end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if Settings.SilentAim then
            silentSnapUntil = tick() + 0.18
        end
        if Settings.Rage then
            pcall(doPointBlankWallbang)
        end
    end
end)

safeConnect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Settings.AimKey then
        aiming = false
        if not Settings.StickyAim then
            currentTarget = nil
            stickyTarget = nil
            smoothedTarget = nil
            smoothedAimPosition = nil
            silentAimPos = nil
        end
    end
end)

pcall(function()
    RunService:BindToRenderStep("YBTHU_SilentRivals_B3", Enum.RenderPriority.Camera.Value + 1, function()
        if not running or not Settings.SilentAim then return end
        if not rivalsSilentActive() then return end

        local part = currentTarget
        if not part or not part.Parent then
            part = getClosestTarget()
            currentTarget = part
        end
        if not part or not part.Parent then return end

        local aimPos = silentAimPos or getPredictedPosition(part)
        if not aimPos then aimPos = part.Position end

        local sp, onScreen = Camera:WorldToViewportPoint(aimPos)
        if sp.Z <= 0 then return end
        if not Settings.Rage then
            if not onScreen then return end
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if dist > getActiveFOV() * 1.35 then return end
        else
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if dist > getActiveFOV() * 1.6 then return end
        end

        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.lookAt(camPos, aimPos)
    end)
end)

print("[YBTHU] Silent RIVALS + Rage v2 listo")

safeConnect(RunService.RenderStepped, function(dt)
    if not running then return end
    if pbBusy and tick() >= pbUntil then
        restorePointBlank()
    end
    local mouseHeld, mouse1Held = false, false
    pcall(function()
        mouseHeld = UserInputService:IsMouseButtonPressed(Settings.AimKey)
        mouse1Held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    end)
    local silentSnap = Settings.SilentAim and (tick() < silentSnapUntil or mouse1Held)
    if Settings.Rage and mouse1Held then
        pcall(doPointBlankWallbang)
    end
    local shouldAim = Settings.Rage or ((Settings.Aimbot or Settings.SilentAim) and (aiming or mouseHeld or mouse1Held or silentSnap))
    if not shouldAim then return end
    if not Settings.Aimbot and not Settings.SilentAim and not Settings.Rage then return end

    local now = os.clock()
    local refresh = Settings.Rage and 0.03 or targetRefreshRate
    if now - lastScan >= refresh or not currentTarget or not currentTarget.Parent then
        lastScan = now
        local nextTarget = getClosestTarget()
        if nextTarget ~= currentTarget then smoothedAimPosition = nil end
        currentTarget = nextTarget
    end

    if not currentTarget or not currentTarget.Parent then
        stickyTarget = nil
        smoothedTarget = nil
        smoothedAimPosition = nil
        silentAimPos = nil
        return
    end

    local targetPos = getPredictedPosition(currentTarget)
    if not targetPos then return end

    if smoothedTarget ~= currentTarget or not smoothedAimPosition then
        smoothedTarget = currentTarget
        smoothedAimPosition = targetPos
    else
        smoothedAimPosition = smoothedAimPosition:Lerp(targetPos, math.clamp(dt * 7, 0.08, 0.28))
    end
    silentAimPos = smoothedAimPosition

    local alpha
    if Settings.Rage then alpha = Settings.RageSmoothness
    elseif silentSnap then alpha = 0.88
    elseif Settings.SilentAim and not Settings.Aimbot then alpha = 0.85
    elseif Settings.SilentAim then alpha = Settings.SilentSmoothness
    else alpha = Settings.Smoothness end

    if Settings.Aimbot or Settings.Rage then
        local screenPoint, onScreen = Camera:WorldToViewportPoint(smoothedAimPosition)
        if onScreen and screenPoint.Z > 0 then
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local deltaX = screenPoint.X - screenCenter.X
            local deltaY = screenPoint.Y - screenCenter.Y
            local screenOffset = math.sqrt(deltaX * deltaX + deltaY * deltaY)

            local deadzone = Settings.Rage and 2.0 or Settings.AimDeadzone
            if screenOffset > deadzone then
                local frameAlpha = 1 - math.pow(1 - math.clamp(alpha, 0.05, 1), math.clamp(dt * 60, 0.35, 1.6))
                local accel = Settings.MouseAccel or 0.95
                local distFactor = math.clamp(screenOffset / 140, 0.40, 1.05)
                local strength = frameAlpha * distFactor * accel
                local maxStep = Settings.Rage and 90 or 28
                local moveX = math.clamp(deltaX * strength, -maxStep, maxStep)
                local moveY = math.clamp(deltaY * strength, -maxStep, maxStep)

                if typeof(mousemoverel) == "function" then
                    mousemoverel(moveX, moveY)
                elseif typeof(Input) == "table" and typeof(Input.MouseMove) == "function" then
                    Input.MouseMove(moveX, moveY)
                end
            end
        end
    end
end)

