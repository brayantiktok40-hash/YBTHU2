    MouseAccel = 0.95,
    TargetRefresh = 0.055,
    WallCheck = false,
    IgnoreTeam = true,
    StickyAim = true,
    ESP = true,
    ColorIndex = 1,
    Language = "ES",
    MenuKey = Enum.KeyCode.Insert,
