safeConnect(UserInputService.InputBegan, function(input, gp)
    if gp or not running then return end
    if input.KeyCode == Settings.MenuKey then
        if minimized then
            minimized = false
            window.Visible = true
            logo.Visible = false
        else
            Settings.Visible = not Settings.Visible
            window.Visible = Settings.Visible
        end
    end
end)

