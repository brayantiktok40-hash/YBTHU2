local function getGuiParent()
    if typeof(gethui) == "function" then local ok, hui = pcall(gethui) if ok and hui then return hui end end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
end

local function notify(title, text, duration)
    pcall(function() StarterGui:SetCore("SendNotification", { Title = title, Text = text, Duration = duration or 4 }) end)
end

notify("YBTHU", Texts[Settings.Language].Credit, 5)

local function getPart(character)
    if not character then return nil end
    if Settings.Rage then return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart") end
    return character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("Head") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if Settings.IgnoreTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then return false end
    return isAlive(player.Character)
end

local function hasLineOfSight(fromPos, toPart, character)
    if Settings.Rage or not Settings.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { Camera }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function getPredictedPosition(part)
    if not part then return nil end
    local pred = Settings.Rage and (Settings.Prediction + 0.14) or Settings.Prediction
    if pred <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function()
        local char = part.Parent
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        local src = root or part
        velocity = src.AssemblyLinearVelocity or src.Velocity or Vector3.zero
    end)
    return part.Position + Vector3.new(velocity.X, velocity.Y * 0.25, velocity.Z) * pred
end

local function getActiveFOV()
    return Settings.Rage and Settings.RageFOV or Settings.FOV
end

local currentTarget, stickyTarget = nil, nil
local silentAimPos = nil
local aiming = false
local lastScan = 0
local targetRefreshRate = Settings.TargetRefresh or 0.055
local smoothedAimPosition = nil
local smoothedTarget = nil
local silentSnapUntil = 0

local function getClosestTarget()
    local fov = getActiveFOV()
    local closest, closestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    if Settings.StickyAim and stickyTarget and stickyTarget.Parent then
        local char = stickyTarget:FindFirstAncestorOfClass("Model") or stickyTarget.Parent
        local player = typeof(char) == "Instance" and char:IsA("Model") and Players:GetPlayerFromCharacter(char)
        local withinDistance = (camPos - stickyTarget.Position).Magnitude <= Settings.MaxDistance
        if player and withinDistance and isValidPlayer(player) then
            local sp, onScreen = Camera:WorldToViewportPoint(stickyTarget.Position)
            if onScreen and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                local stickyMul = Settings.Rage and 1.8 or 1.35
                if dist <= fov * stickyMul and hasLineOfSight(camPos, stickyTarget, char) then return stickyTarget end
            end
        end
        stickyTarget = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local character = player.Character
            local part = getPart(character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end
    stickyTarget = closest
    return closest
end

local function doPointBlankWallbang()
    if not Settings.Rage or not running then return end
    if tick() - lastPB < 0.18 then return end
    local target = currentTarget
    if not target or not target.Parent then
        target = getClosestTarget()
        currentTarget = target
    end
    if not target or not target.Parent then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local tpos = target.Position
    if pbBusy and pbSavedCFrame then
        pbUntil = tick() + 0.14
        lastPB = tick()
        return
    end

    pbBusy = true
    lastPB = tick()
    local ok = pcall(function()
        pbSavedCFrame = root.CFrame
        local dir = (root.Position - tpos)
        if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) end
        dir = dir.Unit
        local nearPos = tpos + dir * 2.2 + Vector3.new(0, 1.2, 0)
        root.CFrame = CFrame.new(nearPos, tpos)
        pbUntil = tick() + 0.14
    end)
    if not ok then
        pbBusy = false
        pbSavedCFrame = nil
    end
end

local function restorePointBlank()
    if not pbSavedCFrame then
        pbBusy = false
        return
    end
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and pbSavedCFrame then
            root.CFrame = pbSavedCFrame
        end
    end)
    pbSavedCFrame = nil
    pbBusy = false
end

local function rivalsSilentActive()
    if not running or not Settings.SilentAim then return false end
    if Settings.Rage then return true end
    local ok = aiming
    pcall(function()
        if UserInputService:IsMouseButtonPressed(Settings.AimKey) then ok = true end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then ok = true end
    end)
    if tick() < silentSnapUntil then ok = true end
    return ok
end

safeConnect(UserInputService.InputBegan, function(input, gp)
    if gp or not running then return end
    if input.UserInputType == Settings.AimKey then aiming = true end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if Settings.SilentAim then
            silentSnapUntil = tick() + 0.18
        end
        if Settings.Rage then
            pcall(doPointBlankWallbang)
        end
    end
end)

safeConnect(UserInputService.InputEnded, function(input)
    if input.UserInputType == Settings.AimKey then
        aiming = false
        if not Settings.StickyAim then
            currentTarget = nil
            stickyTarget = nil
            smoothedTarget = nil
            smoothedAimPosition = nil
            silentAimPos = nil
        end
    end
end)

pcall(function()
    RunService:BindToRenderStep("YBTHU_SilentRivals_B3", Enum.RenderPriority.Camera.Value + 1, function()
        if not running or not Settings.SilentAim then return end
        if not rivalsSilentActive() then return end

        local part = currentTarget
        if not part or not part.Parent then
            part = getClosestTarget()
            currentTarget = part
        end
        if not part or not part.Parent then return end

        local aimPos = silentAimPos or getPredictedPosition(part)
        if not aimPos then aimPos = part.Position end

        local sp, onScreen = Camera:WorldToViewportPoint(aimPos)
        if sp.Z <= 0 then return end
        if not Settings.Rage then
            if not onScreen then return end
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if dist > getActiveFOV() * 1.35 then return end
        else
            local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if dist > getActiveFOV() * 1.6 then return end
        end

        local camPos = Camera.CFrame.Position
        Camera.CFrame = CFrame.lookAt(camPos, aimPos)
    end)
end)

print("[YBTHU] Silent RIVALS + Rage v2 listo")

-- ============================================
-- SKIN CHANGER + VISUAL UNLOCK (Client-side)
-- ============================================
local skinEnabled = false
local currentSkinIndex = 1
local availableSkins = {}
local originalBackups = {}
local unlockConnection = nil

local function getViewModels()
    local ps = LocalPlayer:FindFirstChild("PlayerScripts")
    if not ps then return nil end
    local assets = ps:FindFirstChild("Assets")
    if not assets then return nil end
    return assets:FindFirstChild("ViewModels")
end

local function hideLocks()
    -- Hide lock icons in the inventory UI (visual unlock)
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        for _, gui in ipairs(pg:GetDescendants()) do
            if gui:IsA("ImageLabel") or gui:IsA("ImageButton") then
                local name = string.lower(gui.Name)
                if name:find("lock") or name:find("padlock") or name:find("candado") or name:find("locked") then
                    gui.Visible = false
                    gui.ImageTransparency = 1
                end
            end
            if gui:IsA("TextLabel") then
                local t = string.lower(gui.Text or "")
                if t:find("locked") or t:find("bloquead") then
                    gui.Visible = false
                end
            end
        end
    end)
end

local function tryUnlockLocalData()
    -- Best-effort: mark skins as owned in local tables if they exist
    pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if not ps then return end
        for _, obj in ipairs(ps:GetDescendants()) do
            if typeof(obj) == "Instance" and (obj:IsA("ModuleScript") or obj:IsA("Folder")) then
                -- skip heavy search
            end
        end
    end)
end

local function collectSkins()
    availableSkins = {}
    local vms = getViewModels()
    if not vms then return 0 end
    pcall(function()
        for _, case in ipairs(vms:GetChildren()) do
            if case.Name ~= "Weapons" and case.Name ~= "OriginalBackups" then
                for _, skin in ipairs(case:GetChildren()) do
                    table.insert(availableSkins, {name = skin.Name, path = skin, case = case.Name})
                end
            end
        end
    end)
    return #availableSkins
end

local function backupWeapon(weaponName)
    if originalBackups[weaponName] then return end
    local vms = getViewModels()
    if not vms then return end
    local weapons = vms:FindFirstChild("Weapons")
    if not weapons then return end
    local weapon = weapons:FindFirstChild(weaponName)
    if not weapon then return end
    pcall(function()
        local backupFolder = vms:FindFirstChild("OriginalBackups")
        if not backupFolder then
            backupFolder = Instance.new("Folder")
            backupFolder.Name = "OriginalBackups"
            backupFolder.Parent = vms
        end
        local clone = weapon:Clone()
        clone.Name = weaponName
        clone.Parent = backupFolder
        originalBackups[weaponName] = true
    end)
end

local function applySkinToWeapon(skinData, weaponName)
    if not skinData or not weaponName then return false end
    local vms = getViewModels()
    if not vms then return false end
    local weapons = vms:FindFirstChild("Weapons")
    if not weapons then return false end
    local weapon = weapons:FindFirstChild(weaponName)
    if not weapon then return false end
    backupWeapon(weaponName)
    local ok = pcall(function()
        weapon:ClearAllChildren()
        for _, child in ipairs(skinData.path:GetChildren()) do
            child:Clone().Parent = weapon
        end
    end)
    return ok
end

local function getCurrentEquippedWeapon()
    local name = nil
    pcall(function()
        local firstPerson = workspace:FindFirstChild("ViewModels") and workspace.ViewModels:FindFirstChild("FirstPerson")
        if not firstPerson then return end
        for _, vm in ipairs(firstPerson:GetChildren()) do
            if vm:IsA("Model") and vm.Name:find(LocalPlayer.Name) then
                local parts = string.split(vm.Name, " - ")
                if #parts >= 2 then name = parts[2] break end
            end
        end
    end)
    return name
end

local function toggleSkinChanger()
    skinEnabled = not skinEnabled
    Settings.SkinChanger = skinEnabled
    if skinEnabled then
        hideLocks()
        tryUnlockLocalData()
        local count = collectSkins()
        -- Keep hiding locks while enabled
        if unlockConnection then unlockConnection:Disconnect() end
        unlockConnection = RunService.Heartbeat:Connect(function()
            if skinEnabled then hideLocks() end
        end)
        table.insert(allConnections, unlockConnection)
        notify("YBTHU", "Skin Unlock Visual ON - Candados ocultos. + para ciclar", 4)
    else
        if unlockConnection then pcall(function() unlockConnection:Disconnect() end) end
        notify("YBTHU", "Skin Changer: OFF", 3)
    end
end

safeConnect(UserInputService.InputBegan, function(input, gp)
    if gp or not running or not skinEnabled then return end
    if input.KeyCode == Enum.KeyCode.Equals then
        local count = #availableSkins
        if count == 0 then count = collectSkins() end
        if count > 0 then
            currentSkinIndex = (currentSkinIndex % count) + 1
            local skin = availableSkins[currentSkinIndex]
            local weaponName = getCurrentEquippedWeapon()
            if weaponName and skin then
                if applySkinToWeapon(skin, weaponName) then
                    notify("YBTHU", "Skin: " .. (skin.name or "?") .. " → " .. weaponName, 2)
                end
            else
                notify("YBTHU", "Equipa un arma primero", 2)
            end
        end
    end
end)

-- ============================================
-- TRIGGERBOT + HIT CHANCE (BETA 3.0)
-- ============================================
local lastTriggerShot = 0
safeConnect(RunService.Heartbeat, function()
    if not running or not Settings.Triggerbot then return end
    if tick() - lastTriggerShot < (Settings.AutoFireRate or 0.10) then return end
    if Settings.HitChance < 100 and math.random(1, 100) > Settings.HitChance then return end
    local mouse = LocalPlayer:GetMouse()
    if not mouse or not mouse.Target then return end
    local model = mouse.Target:FindFirstAncestorOfClass("Model")
    if not model then return end
    local player = Players:GetPlayerFromCharacter(model)
    if player and isValidPlayer(player) then
        pcall(function()
            if mouse1click then mouse1click()
            elseif mouse1press then mouse1press() task.wait(0.02) mouse1release() end
        end)
        lastTriggerShot = tick()
    end
end)


safeConnect(RunService.RenderStepped, function(dt)
    if not running then return end
    if pbBusy and tick() >= pbUntil then
        restorePointBlank()
    end
    local mouseHeld, mouse1Held = false, false
    pcall(function()
        mouseHeld = UserInputService:IsMouseButtonPressed(Settings.AimKey)
        mouse1Held = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    end)
    local silentSnap = Settings.SilentAim and (tick() < silentSnapUntil or mouse1Held)
    if Settings.Rage and mouse1Held then
        pcall(doPointBlankWallbang)
    end
    local shouldAim = Settings.Rage or ((Settings.Aimbot or Settings.SilentAim) and (aiming or mouseHeld or mouse1Held or silentSnap))
    if not shouldAim then return end
    if not Settings.Aimbot and not Settings.SilentAim and not Settings.Rage then return end

    local now = os.clock()
    local refresh = Settings.Rage and 0.03 or targetRefreshRate
    if now - lastScan >= refresh or not currentTarget or not currentTarget.Parent then
        lastScan = now
        local nextTarget = getClosestTarget()
        if nextTarget ~= currentTarget then smoothedAimPosition = nil end
        currentTarget = nextTarget
    end

    if not currentTarget or not currentTarget.Parent then
        stickyTarget = nil
        smoothedTarget = nil
        smoothedAimPosition = nil
        silentAimPos = nil
        return
    end

    local targetPos = getPredictedPosition(currentTarget)
    if not targetPos then return end

    if smoothedTarget ~= currentTarget or not smoothedAimPosition then
        smoothedTarget = currentTarget
        smoothedAimPosition = targetPos
    else
        smoothedAimPosition = smoothedAimPosition:Lerp(targetPos, math.clamp(dt * 7, 0.08, 0.28))
    end
    silentAimPos = smoothedAimPosition

    local alpha
    if Settings.Rage then alpha = Settings.RageSmoothness
    elseif silentSnap then alpha = 0.88
    elseif Settings.SilentAim and not Settings.Aimbot then alpha = 0.85
    elseif Settings.SilentAim then alpha = Settings.SilentSmoothness
    else alpha = Settings.Smoothness end

    if Settings.Aimbot or Settings.Rage then
        local screenPoint, onScreen = Camera:WorldToViewportPoint(smoothedAimPosition)
        if onScreen and screenPoint.Z > 0 then
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local deltaX = screenPoint.X - screenCenter.X
            local deltaY = screenPoint.Y - screenCenter.Y
            local screenOffset = math.sqrt(deltaX * deltaX + deltaY * deltaY)

            local deadzone = Settings.Rage and 2.0 or Settings.AimDeadzone
            if screenOffset > deadzone then
                local frameAlpha = 1 - math.pow(1 - math.clamp(alpha, 0.05, 1), math.clamp(dt * 60, 0.35, 1.6))
                local accel = Settings.MouseAccel or 0.95
                local distFactor = math.clamp(screenOffset / 140, 0.40, 1.05)
                local strength = frameAlpha * distFactor * accel
                local maxStep = Settings.Rage and 90 or 28
                local moveX = math.clamp(deltaX * strength, -maxStep, maxStep)
                local moveY = math.clamp(deltaY * strength, -maxStep, maxStep)

                if typeof(mousemoverel) == "function" then
                    mousemoverel(moveX, moveY)
                elseif typeof(Input) == "table" and typeof(Input.MouseMove) == "function" then
                    Input.MouseMove(moveX, moveY)
                end
            end
        end
    end
end)

local fovGui, fovCircle, fovStroke

local function createFOV()
    local p = getGuiParent()
    if not p then return end
    if fovGui then pcall(function() fovGui:Destroy() end) end
    fovGui = Instance.new("ScreenGui")
    fovGui.Name = "YBTHU_FOV"
    fovGuiRef = fovGui
    fovGui.ResetOnSpawn = false
    fovGui.IgnoreGuiInset = true
    fovGui.Parent = p
    fovCircle = Instance.new("Frame")
    fovCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    fovCircle.Position = UDim2.fromScale(0.5, 0.5)
    fovCircle.BackgroundTransparency = 1
    fovCircle.Parent = fovGui
    fovStroke = Instance.new("UIStroke")
    fovStroke.Thickness = 1.4
    fovStroke.Color = Theme.Accent
    fovStroke.Transparency = 0.4
    fovStroke.Parent = fovCircle
    Instance.new("UICorner", fovCircle).CornerRadius = UDim.new(1, 0)
end

local function updateFOV()
    if not fovCircle then return end
    fovCircle.Visible = Settings.ShowFOV
    if Settings.ShowFOV then
        fovCircle.Size = UDim2.fromOffset(getActiveFOV() * 2, getActiveFOV() * 2)
        if fovStroke then fovStroke.Color = Settings.Rage and Theme.Rage or Theme.Accent end
    end
end

createFOV()
updateFOV()

local tracked = {}
task.spawn(function()
    while task.wait(1.5) do
        if not running then break end
        local list = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then table.insert(list, p.Character) end
        end
        tracked = list
    end
end)

safeConnect(RunService.Heartbeat, function()
    if not running or not Settings.ESP then return end
    local color = Settings.ESPColors[Settings.ColorIndex]
    for _, model in pairs(tracked) do
        if model and model.Parent and isAlive(model) then
            local h = model:FindFirstChildOfClass("Highlight")
            if not h then
                h = Instance.new("Highlight")
                h.Parent = model
                h.FillTransparency = 0.55
                h.OutlineTransparency = 0.2
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end
            h.Enabled = true
            h.FillColor = color
            h.OutlineColor = color
        end
    end
end)

task.spawn(function()
    while task.wait(1.2) do
        if not running then break end
        if not Settings.ESP then
            for _, model in pairs(tracked) do
                if model and model.Parent then
                    local h = model:FindFirstChildOfClass("Highlight")
                    if h then h.Enabled = false end
                end
            end
        end
    end
end)

