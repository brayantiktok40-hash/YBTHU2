    Aimbot = true,
    SilentAim = true,
    Rage = false,
    AimKey = Enum.UserInputType.MouseButton2,
    FOV = 340,
    RageFOV = 600,
    ShowFOV = true,
    MaxDistance = 500,
    TargetPart = "Head",
    Smoothness = 0.38,
    AimDeadzone = 5.0,
    SilentSmoothness = 0.70,
    RageSmoothness = 0.98,
    Prediction = 0.12,
    MouseAccel = 0.95,
    TargetRefresh = 0.055,
    WallCheck = false,
    IgnoreTeam = true,
    StickyAim = true,
    ESP = true,
    ColorIndex = 1,
    Language = "ES",
    MenuKey = Enum.KeyCode.Insert,
    Visible = true,
    AutoFireRate = 0.10,
    Triggerbot = false,
    HitChance = 100,
    NoRecoil = false,
