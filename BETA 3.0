do
    local dragging, dragStart, startPos = false, nil, nil
    header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = window.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

local content = Instance.new("ScrollingFrame")
content.Size = UDim2.new(1, -20, 1, -70)
content.Position = UDim2.new(0, 10, 0, 64)
content.BackgroundTransparency = 1
content.BorderSizePixel = 0
content.ScrollBarThickness = 4
content.CanvasSize = UDim2.new(0, 0, 0, 0)
content.AutomaticCanvasSize = Enum.AutomaticSize.Y
content.Parent = window

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = content

local toggleRefs = {}
local labelRefs = {}

local function section(text, order)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Theme.Accent
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.LayoutOrder = order
    lbl.Parent = content
end

local function makeToggle(labelKey, settingKey, order, onColor)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundColor3 = Theme.Card
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.Parent = content
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)
    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(0.6, 0, 1, 0)
    name.Position = UDim2.new(0, 12, 0, 0)
    name.BackgroundTransparency = 1
    name.Text = Texts[Settings.Language][labelKey]
    name.TextColor3 = Theme.Text
    name.Font = Enum.Font.GothamMedium
    name.TextSize = 13
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = row
    local value = Instance.new("TextButton")
    value.Size = UDim2.new(0, 70, 0, 28)
    value.Position = UDim2.new(1, -82, 0.5, -14)
    value.BackgroundColor3 = Settings[settingKey] and (onColor or Theme.On) or Theme.Off
    value.Text = Settings[settingKey] and "ON" or "OFF"
    value.TextColor3 = Theme.Text
    value.Font = Enum.Font.GothamBold
    value.TextSize = 12
    value.Parent = row
    Instance.new("UICorner", value).CornerRadius = UDim.new(0, 8)
    local function refresh()
        value.Text = Settings[settingKey] and "ON" or "OFF"
        value.BackgroundColor3 = Settings[settingKey] and (onColor or Theme.On) or Theme.Off
        name.Text = Texts[Settings.Language][labelKey]
    end
    value.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        if settingKey == "Rage" and Settings.Rage then
            Settings.Aimbot = true
            Settings.WallCheck = false
        end
        -- Al APAGAR Aimbot / Silent / Rage / Triggerbot → limpiar targets
        if settingKey == "Aimbot" or settingKey == "SilentAim" or settingKey == "Rage" or settingKey == "Triggerbot" then
            if not Settings.Aimbot and not Settings.SilentAim and not Settings.Rage then
                currentTarget = nil
                stickyTarget = nil
                smoothedTarget = nil
                smoothedAimPosition = nil
                silentAimPos = nil
                aiming = false
                silentSnapUntil = 0
            end
            if settingKey == "SilentAim" and not Settings.SilentAim then
                silentSnapUntil = 0
                silentAimPos = nil
            end
            if settingKey == "Rage" and not Settings.Rage then
                pcall(restorePointBlank)
            end
        end
        refresh()
        updateFOV()
    end)
    toggleRefs[labelKey] = refresh
    refresh()
end

local function makeCycle(labelKey, order, getText, onClick)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 40)
    row.BackgroundColor3 = Theme.Card
    row.BorderSizePixel = 0
    row.LayoutOrder = order
    row.Parent = content
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 10)
    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(0.45, 0, 1, 0)
    name.Position = UDim2.new(0, 12, 0, 0)
    name.BackgroundTransparency = 1
    name.Text = Texts[Settings.Language][labelKey]
    name.TextColor3 = Theme.Text
    name.Font = Enum.Font.GothamMedium
    name.TextSize = 13
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = row
    local value = Instance.new("TextButton")
    value.Size = UDim2.new(0, 110, 0, 28)
    value.Position = UDim2.new(1, -122, 0.5, -14)
    value.BackgroundColor3 = Theme.Off
    value.Text = getText()
    value.TextColor3 = Theme.Text
    value.Font = Enum.Font.GothamBold
    value.TextSize = 12
    value.Parent = row
    Instance.new("UICorner", value).CornerRadius = UDim.new(0, 8)
    local function refresh() value.Text = getText() name.Text = Texts[Settings.Language][labelKey] end
    value.MouseButton1Click:Connect(function() onClick() refresh() end)
    toggleRefs[labelKey] = refresh
    refresh()
end

local function makeButton(labelKey, order, bgColor, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 40)
    btn.BackgroundColor3 = bgColor or Theme.Card
    btn.Text = Texts[Settings.Language][labelKey]
    btn.TextColor3 = Theme.Text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.LayoutOrder = order
    btn.Parent = content
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    labelRefs[labelKey] = btn
    btn.MouseButton1Click:Connect(onClick)
end

section(Texts[Settings.Language].Combat, 1)
makeToggle("Aim", "Aimbot", 2)
makeToggle("Silent", "SilentAim", 3)
makeToggle("Trigger", "Triggerbot", 4)
makeToggle("Rage", "Rage", 5, Theme.Rage)
makeCycle("Part", 6, function()
    if Settings.Rage then return "Cabeza (Rage)" end
    return Settings.PartNames[Settings.Language][Settings.TargetPart] or Settings.TargetPart
end, function()
    if Settings.Rage then return end
    partIndex = partIndex % #PART_CYCLE + 1
    Settings.TargetPart = PART_CYCLE[partIndex]
end)

section(Texts[Settings.Language].Visuals, 6)
makeToggle("Esp", "ESP", 7)
makeToggle("Fov", "ShowFOV", 8)
makeToggle("Skin", "SkinChanger", 9)
makeCycle("Color", 10, function() return Settings.ColorNames[Settings.Language][Settings.ColorIndex] end, function() Settings.ColorIndex = Settings.ColorIndex % #Settings.ESPColors + 1 end)

section(Texts[Settings.Language].Misc, 10)
makeCycle("Lang", 11, function() return Settings.Language end, function()
    Settings.Language = Settings.Language == "ES" and "EN" or "ES"
    local t = Texts[Settings.Language]
    titleLabel.Text = t.Title
    subLabel.Text = t.Sub
    for _, refresh in pairs(toggleRefs) do pcall(refresh) end
    if labelRefs.Disc then labelRefs.Disc.Text = t.Disc end
    if labelRefs.Kill then labelRefs.Kill.Text = t.Kill end
end)

makeButton("Disc", 12, Theme.Discord, function()
    if setclipboard then pcall(setclipboard, DISCORD_URL) end
    notify("YBTHU", Texts[Settings.Language].Notify, 3)
end)

do
    local killBtn = Instance.new("TextButton")
    killBtn.Size = UDim2.new(1, 0, 0, 44)
    killBtn.BackgroundColor3 = Theme.Rage
    killBtn.Text = Texts[Settings.Language].Kill
    killBtn.TextColor3 = Color3.new(1, 1, 1)
    killBtn.Font = Enum.Font.GothamBold
    killBtn.TextSize = 14
    killBtn.LayoutOrder = 13
    killBtn.ZIndex = 50
    killBtn.Active = true
    killBtn.Parent = content
    Instance.new("UICorner", killBtn).CornerRadius = UDim.new(0, 10)
    labelRefs.Kill = killBtn
    local function doKill() print("[YBTHU] Botón APAGAR presionado") killScript() end
    killBtn.MouseButton1Click:Connect(doKill)
    killBtn.Activated:Connect(doKill)
end

