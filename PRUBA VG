local function obtenerContenedorGUI()
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end

    local okCore, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    if okCore and coreGui then return coreGui end

    local playerGui = player:FindFirstChildOfClass("PlayerGui")
    if playerGui then return playerGui end

    local okPlayer, resultado = pcall(function()
        return player:WaitForChild("PlayerGui", 10)
    end)
    if okPlayer then return resultado end
    return nil
end

local function crearScreenGui(nombre)
    local contenedor = obtenerContenedorGUI()
    if not contenedor then
        warn("PRUBA VG: Real no encontró un contenedor de GUI")
        return nil
    end

    local ok, gui = pcall(function()
        local anterior = contenedor:FindFirstChild(nombre)
        if anterior then anterior:Destroy() end

        local instancia = Instance.new("ScreenGui")
        instancia.Name = nombre
        instancia.ResetOnSpawn = false
        instancia.IgnoreGuiInset = true
        instancia.ZIndexBehavior = Enum.ZIndexBehavior.Global
        instancia.DisplayOrder = 999999
        instancia.Enabled = true
        instancia.Parent = contenedor
        return instancia
    end)
    if not ok or not gui then
        warn("PRUBA VG: Real no pudo crear la GUI")
        return nil
    end
    return gui
end

