-- FUNCIONES DE CLAVE
-- ============================================
local function guardarClave(clave)
    if writefile and isfolder and makefolder then
        if not isfolder("TeleportPro") then makefolder("TeleportPro") end
        pcall(function() writefile("TeleportPro/Key.txt", clave) end)
    end
end

local function cargarClaveGuardada()
    if isfile and isfile("TeleportPro/Key.txt") then
        return readfile("TeleportPro/Key.txt")
    end
    return nil
end

local function verificarClave(clave)
    for _, valida in ipairs(CONFIG.ClavesValidas) do
        if clave == valida then return true end
    end
    return false
end

