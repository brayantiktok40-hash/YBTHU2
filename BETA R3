    safeConnect(UserInputService.InputBegan, function(input, gp)
        if waitingMenuKey then
            if input.KeyCode ~= Enum.KeyCode.Unknown then
                Settings.MenuKey = input.KeyCode
                menuKeyBtn.Text = tostring(input.KeyCode):gsub("Enum.KeyCode.", "")
                waitingMenuKey = false
                notify("YBTHU", "Menú: " .. menuKeyBtn.Text, 2)
            end
        elseif waitingAimKey then
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
                Settings.AimKey = input.UserInputType
                aimKeyBtn.Text = tostring(input.UserInputType):gsub("Enum.UserInputType.", "")
                waitingAimKey = false
                notify("YBTHU", "Aim: " .. aimKeyBtn.Text, 2)
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                -- allow key as well conceptually; stick to mouse for aim usually
            end
        end
    end)

