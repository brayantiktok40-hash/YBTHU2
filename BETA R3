local function getPart(character)
    if not character then return nil end
    if Settings.Rage then
        return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    end
    return character:FindFirstChild(Settings.TargetPart)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if Settings.IgnoreTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    return isAlive(player.Character)
end

local function hasLineOfSight(fromPos, toPart, character)
    if Settings.Rage or not Settings.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { Camera }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function getPredictedPosition(part)
    if not part then return nil end
    local pred = Settings.Rage and (Settings.Prediction + 0.14) or Settings.Prediction
    if pred <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function()
        local char = part.Parent
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        local src = root or part
        velocity = src.AssemblyLinearVelocity or src.Velocity or Vector3.zero
    end)
    return part.Position + Vector3.new(velocity.X, velocity.Y * 0.25, velocity.Z) * pred
end

local function getActiveFOV()
    return Settings.Rage and Settings.RageFOV or Settings.FOV
end

local currentTarget, stickyTarget = nil, nil
local silentAimPos = nil
local aiming = false
local lastScan = 0
local targetRefreshRate = Settings.TargetRefresh or 0.055
local smoothedAimPosition, smoothedTarget = nil, nil
local silentSnapUntil = 0

local function getClosestTarget()
    local fov = getActiveFOV()
    local closest, closestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    if Settings.StickyAim and stickyTarget and stickyTarget.Parent then
        local char = stickyTarget:FindFirstAncestorOfClass("Model") or stickyTarget.Parent
        local player = typeof(char) == "Instance" and char:IsA("Model") and Players:GetPlayerFromCharacter(char)
        local withinDistance = (camPos - stickyTarget.Position).Magnitude <= Settings.MaxDistance
        if player and withinDistance and isValidPlayer(player) then
            local sp, onScreen = Camera:WorldToViewportPoint(stickyTarget.Position)
            if onScreen and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                local stickyMul = Settings.Rage and 1.8 or 1.35
                if dist <= fov * stickyMul and hasLineOfSight(camPos, stickyTarget, char) then
                    return stickyTarget
                end
            end
        end
        stickyTarget = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local character = player.Character
            local part = getPart(character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end
    stickyTarget = closest
    return closest
end

local function doPointBlankWallbang()
    if not Settings.Rage or not running then return end
    if tick() - lastPB < 0.18 then return end
    local target = currentTarget
    if not target or not target.Parent then
        target = getClosestTarget()
        currentTarget = target
    end
    if not target or not target.Parent then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local tpos = target.Position
    if pbBusy and pbSavedCFrame then
        pbUntil = tick() + 0.14
        lastPB = tick()
        return
    end
    pbBusy = true
    lastPB = tick()
    local ok = pcall(function()
        pbSavedCFrame = root.CFrame
        local dir = (root.Position - tpos)
        if dir.Magnitude < 0.5 then dir = Vector3.new(0, 0, 1) end
        dir = dir.Unit
        local nearPos = tpos + dir * 2.2 + Vector3.new(0, 1.2, 0)
        root.CFrame = CFrame.new(nearPos, tpos)
        pbUntil = tick() + 0.14
    end)
    if not ok then
        pbBusy = false
        pbSavedCFrame = nil
    end
end

local function restorePointBlank()
    if not pbSavedCFrame then
        pbBusy = false
        return
    end
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root and pbSavedCFrame then root.CFrame = pbSavedCFrame end
    end)
    pbSavedCFrame = nil
    pbBusy = false
end

local function rivalsSilentActive()
    if not running or not Settings.SilentAim then return false end
    if Settings.Rage then return true end
    local ok = aiming
    pcall(function()
        if UserInputService:IsMouseButtonPressed(Settings.AimKey) then ok = true end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then ok = true end
    end)
    if tick() < silentSnapUntil then ok = true end
    return ok
end

