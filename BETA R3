local function updateFOV()
    if not fovCircle then return end
    local size = getActiveFOV() * 2
    fovCircle.Size = UDim2.fromOffset(size, size)
    fovCircle.Visible = Settings.ShowFOV and (Settings.Aimbot or Settings.SilentAim or Settings.Rage)
    if fovStroke then fovStroke.Color = Settings.Rage and Theme.Rage or Theme.Accent end
end
