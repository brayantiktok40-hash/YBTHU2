local espObjects = {}

local function clearESP(player)
    if espObjects[player] then
        for _, obj in pairs(espObjects[player]) do
            pcall(function() obj:Destroy() end)
        end
        espObjects[player] = nil
    end
    local char = player.Character
    if char then
        for _, ch in ipairs(char:GetChildren()) do
            if ch:IsA("Highlight") and ch.Name == "YBTHU_Chams" then
                pcall(function() ch:Destroy() end)
            end
        end
    end
end

local function updatePlayerESP(player)
    if not Settings.ESP or not isValidPlayer(player) then
        clearESP(player)
        return
    end

    local char = player.Character
    if not char then
        clearESP(player)
        return
    end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not root then
        clearESP(player)
        return
    end

    local dist = (Camera.CFrame.Position - root.Position).Magnitude
    if dist > (Settings.MaxESPDistance or 500) then
        clearESP(player)
        return
    end

    if not espObjects[player] then
        espObjects[player] = {}
    end

    -- Chams
    if Settings.ESPChams then
        local hl = char:FindFirstChild("YBTHU_Chams")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "YBTHU_Chams"
            hl.FillTransparency = 0.6
            hl.OutlineTransparency = 0
            hl.Parent = char
        end
        hl.FillColor = Settings.ESPColors[Settings.ColorIndex] or Theme.Accent
        hl.OutlineColor = Settings.ESPColors[Settings.ColorIndex] or Theme.Accent
        hl.Enabled = true
    else
        local hl = char:FindFirstChild("YBTHU_Chams")
        if hl then hl:Destroy() end
    end
end

