local function destroyDrawingObject(obj)
    if obj == nil then return end
    -- Si es una tabla de objetos (cache de ESP), destruir todos
    if type(obj) == "table" and not obj.Remove and not obj.Destroy and not obj.Visible then
        for k, v in pairs(obj) do
            destroyDrawingObject(v)
            obj[k] = nil
        end
        return
    end
    pcall(function()
        if typeof(obj) == "Instance" then
            if obj.Parent then obj:Destroy() end
        elseif type(obj) == "userdata" or type(obj) == "table" then
            -- Drawing API: algunos executors usan Remove, otros Destroy
            if obj.Visible ~= nil then obj.Visible = false end
            if obj.Remove then
                obj:Remove()
            elseif obj.Destroy then
                obj:Destroy()
            end
        end
    end)
end

local function destroyESP(player)
    local cache = espCache[player]
    if not cache then return end
    destroyDrawingObject(cache)
    espCache[player] = nil
end

