-- SILENT AIM REAL (hook SEGURO)
-- Solo interviene en workspace:Raycast
-- NO toca ScreenPointToRay / ViewportPointToRay (eso crasheaba)
-- Solo cuando disparas (M1) o Rage
-- =====================================================
local silentHookInstalled = false
pcall(function()
    if typeof(getrawmetatable) ~= "function" then return end
    local mt = getrawmetatable(game)
    if not mt or not mt.__namecall then return end
    local oldNamecall = mt.__namecall
    pcall(function()
        if typeof(setreadonly) == "function" then setreadonly(mt, false) end
    end)

    local function namecallHook(self, ...)
        -- Siempre devolver al original si algo falla
        local args = { ... }
        local success, result = pcall(function()
            -- checkcaller evita bucles raros en algunos executors
            if typeof(checkcaller) == "function" and checkcaller() then
                return nil -- dejar pasar, se maneja abajo
            end
            if not running or not Settings.SilentAim then return nil end
            if not rivalsSilentActive() then return nil end

            local method = typeof(getnamecallmethod) == "function" and getnamecallmethod() or nil
            -- SOLO Raycast de workspace (nada de ScreenPointToRay)
            if method ~= "Raycast" or self ~= workspace then return nil end
            if typeof(args[1]) ~= "Vector3" or typeof(args[2]) ~= "Vector3" then return nil end

            local aimPos = getSilentAimPosition()
            if not aimPos then return nil end

            local origin = args[1]
            local dir = aimPos - origin
            if dir.Magnitude < 0.05 then return nil end

            local len = math.max(args[2].Magnitude, 1)
            args[2] = dir.Unit * len
            return true -- signal: use modified args
        end)

        if success and result == true then
            return oldNamecall(self, table.unpack(args))
        end
        return oldNamecall(self, ...)
    end

    if typeof(newcclosure) == "function" then
        mt.__namecall = newcclosure(namecallHook)
    else
        mt.__namecall = namecallHook
    end
    pcall(function()
        if typeof(setreadonly) == "function" then setreadonly(mt, true) end
    end)
    silentHookInstalled = true
    print("[YBTHU] Silent Aim REAL: hook Raycast seguro instalado")
end)

