local function applyAntiFlash()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for _, g in ipairs(pg:GetDescendants()) do
        local n = string.lower(g.Name)
        if n:find("flash") or n:find("blind") or n:find("stun") or n:find("whiteout") then
            if g:IsA("GuiObject") then
                g.Visible = false
                if g:IsA("Frame") or g:IsA("TextLabel") or g:IsA("ImageLabel") then
                    g.BackgroundTransparency = 1
                end
                if g:IsA("ImageLabel") or g:IsA("ImageButton") then
                    g.ImageTransparency = 1
                end
            end
        end
    end
end

local function applyAntiSmoke()
    for _, p in ipairs(workspace:GetDescendants()) do
        local n = string.lower(p.Name)
        if n:find("smoke") or n:find("cloud") or n:find("gas") or n:find("fog") then
            if p:IsA("ParticleEmitter") or p:IsA("Smoke") then
                p.Enabled = false
            elseif p:IsA("BasePart") and p.Transparency < 1 then
                -- no tocar geometría real
            end
        end
    end
    local lighting = game:GetService("Lighting")
    pcall(function()
        if lighting:FindFirstChildOfClass("Atmosphere") and Settings.AntiSmoke then
            lighting:FindFirstChildOfClass("Atmosphere").Density = 0
        end
    end)
end

safeConnect(RunService.Heartbeat, function()
    if not running then return end

    if Settings.RapidFire and isM1Held() then
        if tick() - lastRapid >= 0.04 then
            lastRapid = tick()
            pcall(function()
                if typeof(mouse1click) == "function" then
                    mouse1click()
                elseif typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
                    mouse1press()
                    task.defer(function() pcall(mouse1release) end)
                end
            end)
        end
    end

    if Settings.NoRecoil and isM1Held() then
        pcall(function()
            if lastCamCFrame then
                local now = Camera.CFrame
                local pos = now.Position
                local lastLook = lastCamCFrame.LookVector
                local curLook = now.LookVector
                -- Correccion mas agresiva del kick vertical
                if (curLook.Y - lastLook.Y) > 0.0015 then
                    local mixed = Vector3.new(curLook.X * 0.15 + lastLook.X * 0.85, lastLook.Y, curLook.Z * 0.15 + lastLook.Z * 0.85)
                    if mixed.Magnitude > 0.001 then
                        Camera.CFrame = CFrame.lookAt(pos, pos + mixed.Unit)
                    end
                end
            end
            lastCamCFrame = Camera.CFrame
        end)
    else
        lastCamCFrame = Camera.CFrame
    end

    if tick() - lastVisualScan > 0.25 then
        lastVisualScan = tick()
        if Settings.AntiFlash then pcall(applyAntiFlash) end
        if Settings.AntiSmoke then pcall(applyAntiSmoke) end
    end
end)

