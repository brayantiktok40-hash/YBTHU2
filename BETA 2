local function loadConfig()
    local raw = nil
    if isfile and readfile and isfile(CONFIG_NAME) then
        local ok, content = pcall(readfile, CONFIG_NAME)
        if ok then raw = content end
    end
    if not raw and Runtime.__YBTHU_R3_CONFIG then
        raw = Runtime.__YBTHU_R3_CONFIG
    end
    if not raw then return false end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(raw)
    end)
    if not ok or type(data) ~= "table" then return false end
    for k, v in pairs(data) do
        if Settings[k] ~= nil and k ~= "MenuKey" and k ~= "AimKey" and k ~= "ESPColors" and k ~= "ColorNames" and k ~= "PartNames" then
            Settings[k] = v
        end
    end
    local mk = restoreEnum(data.MenuKey)
    if mk then Settings.MenuKey = mk end
    local ak = restoreEnum(data.AimKey)
    if ak then Settings.AimKey = ak end
    return true
end

