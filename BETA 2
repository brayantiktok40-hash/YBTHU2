-- Arrastre
do
    local dragging, dragStart, startPos = false, nil, nil

    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Settings.MenuKey then
        Settings.Visible = not Settings.Visible
        frame.Visible = Settings.Visible
    end
end)

local buttonUpdaters = {}

local function createButton(yPos, kind)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0.9, 0, 0, 34)
    btn.Position = UDim2.new(0.05, 0, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 13
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local function update()
        local t = Texts[Settings.Language]
        if kind == "aim" then
            btn.Text = t.Aim .. (Settings.Aimbot and ": ON" or ": OFF")
            btn.BackgroundColor3 = Settings.Aimbot and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(120, 40, 40)
        elseif kind == "silent" then
            btn.Text = t.Silent .. (Settings.SilentAim and ": ON" or ": OFF")
            btn.BackgroundColor3 = Settings.SilentAim and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(120, 40, 40)
        elseif kind == "esp" then
            btn.Text = t.Esp .. (Settings.ESP and ": ON" or ": OFF")
            btn.BackgroundColor3 = Settings.ESP and Color3.fromRGB(40, 120, 60) or Color3.fromRGB(120, 40, 40)
        elseif kind == "color" then
            btn.Text = t.Color .. ": " .. Settings.ColorNames[Settings.Language][Settings.ColorIndex]
            btn.TextColor3 = Settings.ESPColors[Settings.ColorIndex]
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        elseif kind == "lang" then
            btn.Text = t.Lang
            btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            btn.TextColor3 = Color3.new(1, 1, 1)
        elseif kind == "discord" then
            btn.Text = t.Disc
            btn.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
            btn.TextColor3 = Color3.new(1, 1, 1)
        end
    end

    btn.MouseButton1Click:Connect(function()
        if kind == "aim" then
            Settings.Aimbot = not Settings.Aimbot
        elseif kind == "silent" then
            Settings.SilentAim = not Settings.SilentAim
        elseif kind == "esp" then
            Settings.ESP = not Settings.ESP
        elseif kind == "color" then
            Settings.ColorIndex = Settings.ColorIndex % #Settings.ESPColors + 1
        elseif kind == "lang" then
            Settings.Language = Settings.Language == "ES" and "EN" or "ES"
            title.Text = Texts[Settings.Language].Title
            for _, u in ipairs(buttonUpdaters) do u() end
            return
        elseif kind == "discord" then
            if setclipboard then pcall(setclipboard, DISCORD_URL) end
            notify("YBTHU", Texts[Settings.Language].Notify, 3)
        end
        update()
    end)

    table.insert(buttonUpdaters, update)
    update()
end

createButton(50, "aim")
createButton(95, "silent")
createButton(140, "esp")
createButton(185, "color")
createButton(230, "lang")
createButton(280, "discord")

