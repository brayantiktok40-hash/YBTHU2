-- ============================================
-- UTILIDADES
-- ============================================
local function getGuiParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
end

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 4,
        })
    end)
end

notify("YBTHU", Texts[Settings.Language].Credit, 5)

local function getTargetPart(character)
    if not character then return nil end
    return character:FindFirstChild(Settings.TargetPart)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("HumanoidRootPart")
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if Settings.IgnoreSameTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    return true
end

-- ============================================
-- TARGET FINDER (optimizado, no cada frame)
-- ============================================
local currentTarget = nil
local lastScan = 0
local SCAN_INTERVAL = 0.05 -- 20 veces por segundo máx

local function getClosestTarget()
    local closest = nil
    local closestDist = Settings.FOV
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local part = getTargetPart(player.Character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and screenPos.Z > 0 then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if screenDist < closestDist then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end

    return closest
end

-- ============================================
-- AIMBOT (cámara) - estable, sin hooks
-- ============================================
local aiming = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Settings.AimKey then
        aiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Settings.AimKey then
        aiming = false
    end
end)

RunService:BindToRenderStep("YBTHU_Aim", Enum.RenderPriority.Camera.Value + 1, function()
    -- Solo buscar target cuando se está apuntando (ahorra CPU)
    if not aiming then
        currentTarget = nil
        return
    end

    if not Settings.Aimbot and not Settings.SilentAim then
        return
    end

    local now = tick()
    if now - lastScan >= SCAN_INTERVAL then
        lastScan = now
        currentTarget = getClosestTarget()
    end

    if not currentTarget or not currentTarget.Parent then return end

    local smoothness = Settings.SilentAim and Settings.SilentSmoothness or Settings.Smoothness
    local camPos = Camera.CFrame.Position
    local desired = CFrame.lookAt(camPos, currentTarget.Position)
    Camera.CFrame = Camera.CFrame:Lerp(desired, smoothness)
end)

-- ============================================
-- ESP (ligero)
-- ============================================
local tracked = {}

local function refreshTargets()
    local list = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            table.insert(list, player.Character)
        end
    end
    tracked = list
end

task.spawn(function()
    while task.wait(2) do
        refreshTargets()
    end
end)

RunService.Heartbeat:Connect(function()
    if not Settings.ESP then return end

    local color = Settings.ESPColors[Settings.ColorIndex]

    for _, model in pairs(tracked) do
        if model and model.Parent then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local highlight = model:FindFirstChildOfClass("Highlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = model
                    highlight.FillTransparency = 0.55
                    highlight.OutlineTransparency = 0.2
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                highlight.Enabled = true
                highlight.FillColor = color
                highlight.OutlineColor = color
            end
        end
    end
end)

-- Desactivar highlights cuando ESP está off
task.spawn(function()
    while task.wait(1) do
        if not Settings.ESP then
            for _, model in pairs(tracked) do
                if model and model.Parent then
                    local h = model:FindFirstChildOfClass("Highlight")
                    if h then h.Enabled = false end
                end
            end
        end
    end
end)

