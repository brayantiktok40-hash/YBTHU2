local function restoreEnum(str)
    if type(str) ~= "string" then return nil end
    local enumType, name = string.match(str, "Enum%.(%w+)%.(%w+)")
    if enumType and name then
        local ok, val = pcall(function() return Enum[enumType][name] end)
        if ok and val then return val end
    end
    local nameOnly = string.match(str, "([^%.]+)$")
    if nameOnly then
        if Enum.KeyCode[nameOnly] then return Enum.KeyCode[nameOnly] end
        if Enum.UserInputType[nameOnly] then return Enum.UserInputType[nameOnly] end
    end
    return nil
end

local function enumName(e)
    local s = tostring(e)
    return (string.gsub(s, "Enum%.KeyCode%.", ""):gsub("Enum%.UserInputType%.", ""))
end

