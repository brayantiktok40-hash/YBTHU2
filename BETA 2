-- ============================================
-- UTILS
-- ============================================
local function getGuiParent()
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and hui then return hui end
    end
    local ok, core = pcall(function() return game:GetService("CoreGui") end)
    if ok and core then return core end
    return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
end

local function notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 4,
        })
    end)
end

notify("YBTHU", Texts[Settings.Language].Credit, 5)

local function getPart(character)
    if not character then return nil end
    return character:FindFirstChild(Settings.TargetPart)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if Settings.IgnoreTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    return isAlive(player.Character)
end

local function hasLineOfSight(fromPos, toPart, character)
    if not Settings.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { Camera }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function getPredictedPosition(part)
    if not part then return nil end
    if Settings.Prediction <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function()
        velocity = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    end)
    return part.Position + velocity * Settings.Prediction
end

-- ============================================
-- TARGET FINDER (más fiable)
-- ============================================
local currentTarget, stickyTarget = nil, nil
local aiming = false

local function getClosestTarget()
    local closest, closestDist = nil, Settings.FOV
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    -- Sticky aim
    if Settings.StickyAim and stickyTarget and stickyTarget.Parent then
        local char = stickyTarget:FindFirstAncestorOfClass("Model") or stickyTarget.Parent
        if typeof(char) == "Instance" and char:IsA("Model") and isAlive(char) then
            local player = Players:GetPlayerFromCharacter(char)
            if player and isValidPlayer(player) then
                local sp, onScreen = Camera:WorldToViewportPoint(stickyTarget.Position)
                if onScreen and sp.Z > 0 then
                    local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if dist <= Settings.FOV * 1.25 and hasLineOfSight(camPos, stickyTarget, char) then
                        return stickyTarget
                    end
                end
            end
        end
        stickyTarget = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local character = player.Character
            local part = getPart(character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end

    stickyTarget = closest
    return closest
end

-- ============================================
-- AIMBOT (seguimiento fuerte)
-- ============================================
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Settings.AimKey then
        aiming = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Settings.AimKey then
        aiming = false
        if not Settings.StickyAim then
            currentTarget = nil
            stickyTarget = nil
        end
    end
end)

-- Usar RenderStepped para mover la cámara cada frame
RunService.RenderStepped:Connect(function(dt)
    if not aiming then return end
    if not Settings.Aimbot and not Settings.SilentAim then return end

    currentTarget = getClosestTarget()
    if not currentTarget or not currentTarget.Parent then return end

    local targetPos = getPredictedPosition(currentTarget)
    if not targetPos then return end

    local camPos = Camera.CFrame.Position
    local desired = CFrame.lookAt(camPos, targetPos)

    -- Fuerza del aim
    local alpha
    if Settings.SilentAim and not Settings.Aimbot then
        alpha = 0.95 -- casi snap
    elseif Settings.SilentAim and Settings.Aimbot then
        alpha = Settings.SilentSmoothness -- fuerte
    else
        alpha = Settings.Smoothness -- suave
    end

    -- Clamp por seguridad
    alpha = math.clamp(alpha, 0.05, 1)

    -- Aplicar seguimiento
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)

