local function getClosestTarget()
    local fov = getActiveFOV()
    local closest, closestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    if Settings.StickyAim and stickyTarget and stickyTarget.Parent then
        local char = stickyTarget:FindFirstAncestorOfClass("Model") or stickyTarget.Parent
        local player = typeof(char) == "Instance" and char:IsA("Model") and Players:GetPlayerFromCharacter(char)
        local withinDistance = (camPos - stickyTarget.Position).Magnitude <= Settings.MaxDistance
        if player and withinDistance and isValidPlayer(player) then
            local sp, onScreen = Camera:WorldToViewportPoint(stickyTarget.Position)
            if onScreen and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                local stickyMul = Settings.Rage and 2.4 or 1.9
                if dist <= fov * stickyMul and hasLineOfSight(camPos, stickyTarget, char) then
                    return stickyTarget
                end
            end
        end
        stickyTarget = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local character = player.Character
            local part = getPart(character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if Settings.Rage then
                        -- Rage: prioriza distancia en mundo, no solo pantalla
                        local score = worldDist
                        if onScreen and sp.Z > 0 then
                            score = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        else
                            score = 500 + worldDist  -- off-screen penalizado pero permitido
                        end
                        if score < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = score
                            closest = part
                        end
                    elseif onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end
    stickyTarget = closest
    return closest
end

local function doPointBlankWallbang()
    if not Settings.Rage or not Settings.RageWallbang or not running then return end
    if tick() - lastPB < PB_COOLDOWN then return end
    local target = currentTarget
    if not target or not target.Parent then
        target = getClosestTarget()
        currentTarget = target
    end
    if not target or not target.Parent then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local tpos = target.Position

    -- Si ya estas en wallbang, solo extender el tiempo
    if pbBusy and pbSavedCFrame then
        pbUntil = tick() + PB_HOLD_TIME
        lastPB = tick()
        return
    end

    pbBusy = true
    lastPB = tick()
    local ok = pcall(function()
        -- Guardar posicion del personaje Y de la camara
        pbSavedCFrame = root.CFrame
        pbSavedCamCFrame = Camera.CFrame
        pbSavedCamType = Camera.CameraType

        -- Congelar camara (no se mueve aunque el body se teletransporte)
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = pbSavedCamCFrame

        -- Colocarse DETRAS del enemigo (espalda) en vez de al frente
        local targetRoot = target.Parent and target.Parent:FindFirstChild("HumanoidRootPart")
        local lookVec
        if targetRoot then
            lookVec = targetRoot.CFrame.LookVector
        else
            -- fallback si no hay HRP
            lookVec = (tpos - root.Position).Unit
        end
        local behindDir = -lookVec  -- direccion opuesta a donde mira el enemigo
        if behindDir.Magnitude < 0.1 then behindDir = Vector3.new(0, 0, -1) end
        behindDir = behindDir.Unit
        local nearPos = tpos + behindDir * 2.8 + Vector3.new(0, 1.0, 0)
        root.CFrame = CFrame.lookAt(nearPos, tpos)  -- mirando hacia el enemigo desde atras

        pbUntil = tick() + PB_HOLD_TIME
    end)
    if not ok then
        pbBusy = false
        pbSavedCFrame = nil
        pbSavedCamCFrame = nil
        pcall(function()
            if pbSavedCamType then Camera.CameraType = pbSavedCamType end
        end)
        pbSavedCamType = nil
    end
end

-- Mantener camara fija mientras el body esta en wallbang
local function keepPointBlankCamera()
    if not pbBusy or not pbSavedCamCFrame then return end
    pcall(function()
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = pbSavedCamCFrame
    end)
end

