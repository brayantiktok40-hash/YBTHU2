    if dist > (Settings.MaxESPDistance or 500) then
        destroyESP(player)
        return
    end

    if not espCache[player] then espCache[player] = {} end
    local cache = espCache[player]
    local col = getColor()

    if Settings.ESPChams then
        local hl = cache.highlight
        if not hl or not hl.Parent then
            hl = Instance.new("Highlight")
            hl.Name = "YBTHU_Chams"
            hl.FillTransparency = 0.55
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            cache.highlight = hl
        end
        hl.FillColor = col
        hl.OutlineColor = col
        hl.Enabled = true
    else
        if cache.highlight then
            pcall(function() cache.highlight:Destroy() end)
            cache.highlight = nil
        end
    end

    if not drawingAvailable then return end

    local headPos, headOn = Camera:WorldToViewportPoint(head.Position)
    local rootPos, rootOn = Camera:WorldToViewportPoint(root.Position)
    local topPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
    local bottomPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

    if Settings.ESPBoxes and headOn and rootOn and headPos.Z > 0 then
        local box = cache.box
        if not box then
            box = createDrawing("Square", { Thickness = 1, Filled = false, Visible = true })
            cache.box = box
        end
        if box then
            local h = math.abs(topPos.Y - bottomPos.Y)
            local w = h * 0.6
            box.Size = Vector2.new(w, h)
            box.Position = Vector2.new(headPos.X - w / 2, topPos.Y)
            box.Color = col
            box.Visible = true
        end
    elseif cache.box then
        cache.box.Visible = false
    end

    if Settings.ESPNames and headOn and headPos.Z > 0 then
        local name = cache.name
        if not name then
            name = createDrawing("Text", { Size = 13, Center = true, Outline = true, Visible = true })
            cache.name = name
        end
        if name then
            name.Text = player.Name
            name.Position = Vector2.new(headPos.X, topPos.Y - 16)
            if Settings.ESPNameRGB then
                local uid = 0
                pcall(function() uid = player.UserId % 50 end)
                name.Color = rainbowColor(2.4, uid * 0.12)
            else
                name.Color = col
            end
            name.Visible = true
        end
    elseif cache.name then
        cache.name.Visible = false
    end

    if Settings.ESPHealth and hum and headOn and headPos.Z > 0 then
        local barBg = cache.healthBg
        local barFg = cache.healthFg
        if not barBg then
            barBg = createDrawing("Square", { Thickness = 1, Filled = true, Color = Color3.fromRGB(30, 30, 30), Visible = true })
            cache.healthBg = barBg
        end
        if not barFg then
            barFg = createDrawing("Square", { Thickness = 1, Filled = true, Visible = true })
            cache.healthFg = barFg
        end
        if barBg and barFg then
            local h = math.abs(topPos.Y - bottomPos.Y)
            local w = 3
            local hp = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            barBg.Size = Vector2.new(w, h)
            barBg.Position = Vector2.new(headPos.X - (h * 0.6) / 2 - 6, topPos.Y)
            barBg.Visible = true
            barFg.Size = Vector2.new(w, h * hp)
            barFg.Position = Vector2.new(headPos.X - (h * 0.6) / 2 - 6, topPos.Y + h * (1 - hp))
            barFg.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 40)
            barFg.Visible = true
        end
    else
        if cache.healthBg then cache.healthBg.Visible = false end
        if cache.healthFg then cache.healthFg.Visible = false end
    end

    if Settings.ESPDistance and headOn and headPos.Z > 0 then
        local distLabel = cache.dist
        if not distLabel then
            distLabel = createDrawing("Text", { Size = 12, Center = true, Outline = true, Visible = true })
            cache.dist = distLabel
        end
        if distLabel then
            distLabel.Text = string.format("[%dm]", math.floor(dist))
            distLabel.Position = Vector2.new(headPos.X, bottomPos.Y + 2)
            distLabel.Color = col
            distLabel.Visible = true
        end
    elseif cache.dist then
        cache.dist.Visible = false
    end

    if Settings.ESPTracers and rootOn and rootPos.Z > 0 then
        local tracer = cache.tracer
        if not tracer then
            tracer = createDrawing("Line", { Thickness = 1, Visible = true })
            cache.tracer = tracer
        end
        if tracer then
            tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            tracer.To = Vector2.new(rootPos.X, rootPos.Y)
            tracer.Color = col
            tracer.Visible = true
        end
    elseif cache.tracer then
        cache.tracer.Visible = false
    end

    if Settings.ESPSkeleton then
        if not cache.skel then cache.skel = {} end
        local rig = char:FindFirstChild("UpperTorso") and SKELETON_R15 or SKELETON_R6
        for i, conn in ipairs(rig) do
            local p1 = char:FindFirstChild(conn[1])
            local p2 = char:FindFirstChild(conn[2])
            local line = cache.skel[i]
            if p1 and p2 then
                local a, aOn = Camera:WorldToViewportPoint(p1.Position)
                local b, bOn = Camera:WorldToViewportPoint(p2.Position)
                if aOn and bOn and a.Z > 0 and b.Z > 0 then
                    if not line then
                        line = createDrawing("Line", { Thickness = 1.2, Visible = true })
                        cache.skel[i] = line
                    end
                    if line then
                        line.From = Vector2.new(a.X, a.Y)
                        line.To = Vector2.new(b.X, b.Y)
                        line.Color = col
                        line.Visible = true
                    end
                elseif line then
                    line.Visible = false
                end
            elseif line then
                line.Visible = false
            end
        end
    elseif cache.skel then
        for _, line in pairs(cache.skel) do
            if line then line.Visible = false end
        end
    end

    if Settings.ESPArrows then
        local arrow = cache.arrow
        if not arrow then
            arrow = createDrawing("Triangle", { Thickness = 1, Filled = true, Visible = false })
            if not arrow then
                arrow = createDrawing("Square", { Thickness = 1, Filled = true, Visible = false })
            end
            cache.arrow = arrow
        end
        if arrow then
            local sp, onScreen = Camera:WorldToViewportPoint(root.Position)
            if not onScreen or sp.Z <= 0 then
                local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local dir = Vector2.new(sp.X - center.X, sp.Y - center.Y)
                if sp.Z < 0 then dir = -dir end
                if dir.Magnitude < 1 then dir = Vector2.new(0, -1) end
                dir = dir.Unit
                local edge = center + dir * (math.min(Camera.ViewportSize.X, Camera.ViewportSize.Y) * 0.42)
                if arrow.PointA then
                    local size = 10
                    local perp = Vector2.new(-dir.Y, dir.X)
                    arrow.PointA = edge
                    arrow.PointB = edge - dir * size + perp * (size * 0.6)
                    arrow.PointC = edge - dir * size - perp * (size * 0.6)
                else
                    arrow.Size = Vector2.new(10, 10)
                    arrow.Position = edge - Vector2.new(5, 5)
                end
                arrow.Color = col
                arrow.Visible = true
            else
                arrow.Visible = false
            end
        end
    elseif cache.arrow then
        cache.arrow.Visible = false
    end
end

