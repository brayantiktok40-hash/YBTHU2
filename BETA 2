-- Helper: newcclosure seguro (Real lo tiene, otros a veces no)
local function safeClosure(fn)
    if typeof(newcclosure) == "function" then
        local ok, c = pcall(newcclosure, fn)
        if ok and c then return c end
    end
    return fn
end


