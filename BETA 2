-- ===================== SKIN CHANGER RIVALS (reescrito) =====================
-- Ruta real: PlayerScripts.Assets.ViewModels
-- Cases: "Skin Case 2", "Spooky Skin Case", "Festive Skin Case", "Other", etc.
-- Armas: ViewModels.Weapons.<WeaponName>
-- Equipado: workspace.ViewModels.FirstPerson["Nombre - Arma"]
local availableSkins = {}
local currentSkinIndex = 1
local originalBackups = {}
local SKIN_CASE_KEYWORDS = { "skin", "case", "spooky", "festive", "other", "wrap", "charm", "season" }

local function getViewModels()
    -- Prioridad 1: ruta oficial de Rivals (sin WaitForChild para no congelar)
    local ok, vms = pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if not ps then return nil end
        local assets = ps:FindFirstChild("Assets")
        if not assets then return nil end
        return assets:FindFirstChild("ViewModels")
    end)
    if ok and vms then return vms end

    -- Fallbacks
    local candidates = {}
    pcall(function()
        local ps = LocalPlayer:FindFirstChild("PlayerScripts")
        if ps then
            table.insert(candidates, ps:FindFirstChild("ViewModels"))
            local a = ps:FindFirstChild("Assets")
            if a then table.insert(candidates, a:FindFirstChild("ViewModels")) end
        end
    end)
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        table.insert(candidates, rs:FindFirstChild("ViewModels"))
        local a = rs:FindFirstChild("Assets")
        if a then table.insert(candidates, a:FindFirstChild("ViewModels")) end
    end)
    for _, c in ipairs(candidates) do
        if c and (c:FindFirstChild("Weapons") or #c:GetChildren() > 1) then return c end
    end
    for _, c in ipairs(candidates) do
        if c then return c end
    end
    return nil
end

local function hideLocks()
    pcall(function()
        local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if not pg then return end
        for _, gui in ipairs(pg:GetDescendants()) do
            if gui:IsA("ImageLabel") or gui:IsA("ImageButton") then
                local name = string.lower(gui.Name)
                if name:find("lock") or name:find("padlock") or name:find("candado") or name:find("locked") then
                    gui.Visible = false
                    gui.ImageTransparency = 1
                end
            elseif gui:IsA("TextLabel") then
                local t = string.lower(gui.Text or "")
                if t:find("locked") or t:find("bloquead") then
                    gui.Visible = false
                end
            end
        end
    end)
end

local function isSkinCaseFolder(folder)
    if not folder then return false end
    local n = string.lower(folder.Name)
    if n == "weapons" or n == "originalbackups" then return false end
    for _, kw in ipairs(SKIN_CASE_KEYWORDS) do
        if n:find(kw, 1, true) then return true end
    end
    -- Si tiene varios hijos modelo/folder, tambien cuenta
    return #folder:GetChildren() > 0 and not folder:FindFirstChildOfClass("Humanoid")
end

local function collectSkins()
    availableSkins = {}
    local vms = getViewModels()
    if not vms then
        print("[YBTHU] SkinChanger: NO se encontro ViewModels")
        print("[YBTHU] Esperado: PlayerScripts.Assets.ViewModels")
        return 0
    end
    print("[YBTHU] SkinChanger: ViewModels =", vms:GetFullName())

    pcall(function()
        -- 1) Carpetas tipo Skin Case
        for _, case in ipairs(vms:GetChildren()) do
            if isSkinCaseFolder(case) then
                for _, skin in ipairs(case:GetChildren()) do
                    if skin:IsA("Folder") or skin:IsA("Model") or skin:IsA("Configuration") then
                        table.insert(availableSkins, {
                            name = skin.Name,
                            path = skin,
                            case = case.Name
                        })
                    end
                end
            end
        end

        -- 2) Skins sueltas en la raiz de ViewModels (no Weapons)
        local weaponsFolder = vms:FindFirstChild("Weapons")
        for _, child in ipairs(vms:GetChildren()) do
            if child.Name ~= "Weapons" and child.Name ~= "OriginalBackups" and not isSkinCaseFolder(child) then
                if child:IsA("Folder") or child:IsA("Model") then
                    -- Evitar duplicar armas base
                    local isBaseWeapon = weaponsFolder and weaponsFolder:FindFirstChild(child.Name)
                    if not isBaseWeapon then
                        table.insert(availableSkins, {
                            name = child.Name,
                            path = child,
                            case = "Root"
                        })
                    end
                end
            end
        end
    end)

    print("[YBTHU] SkinChanger: skins encontradas =", #availableSkins)
    if #availableSkins > 0 then
        print("[YBTHU] Ejemplos:", availableSkins[1].name, availableSkins[math.min(2, #availableSkins)].name)
    end
    return #availableSkins
end

local function backupWeapon(weaponName)
    if originalBackups[weaponName] then return end
    local vms = getViewModels()
    if not vms then return end
    local weapons = vms:FindFirstChild("Weapons")
    if not weapons then return end
    local weapon = weapons:FindFirstChild(weaponName)
    if not weapon then return end
    pcall(function()
        local backupFolder = vms:FindFirstChild("OriginalBackups")
        if not backupFolder then
            backupFolder = Instance.new("Folder")
            backupFolder.Name = "OriginalBackups"
            backupFolder.Parent = vms
        end
        if not backupFolder:FindFirstChild(weaponName) then
            local clone = weapon:Clone()
            clone.Name = weaponName
            clone.Parent = backupFolder
        end
        originalBackups[weaponName] = true
    end)
end

local function applySkinToWeapon(skinData, weaponName)
    if not skinData or not weaponName then return false end
    local vms = getViewModels()
    if not vms then return false end

    -- Preferir Weapons folder; si no, buscar en raiz
    local weapon = nil
    local weapons = vms:FindFirstChild("Weapons")
    if weapons then
        weapon = weapons:FindFirstChild(weaponName)
    end
    if not weapon then
        weapon = vms:FindFirstChild(weaponName)
    end
    if not weapon then
        print("[YBTHU] SkinChanger: arma no encontrada:", weaponName)
        return false
    end

    backupWeapon(weaponName)

    local ok, err = pcall(function()
        weapon:ClearAllChildren()
        for _, child in ipairs(skinData.path:GetChildren()) do
            local c = child:Clone()
            c.Parent = weapon
        end
    end)
    if not ok then
        print("[YBTHU] SkinChanger error al aplicar:", err)
    end
    return ok
end

local function getCurrentEquippedWeapon()
    local name = nil
    -- Metodo principal: workspace.ViewModels.FirstPerson["PlayerName - Weapon"]
    pcall(function()
        local wsv = workspace:FindFirstChild("ViewModels")
        local firstPerson = wsv and wsv:FindFirstChild("FirstPerson")
        if firstPerson then
            for _, vm in ipairs(firstPerson:GetChildren()) do
                if typeof(vm.Name) == "string" and string.find(vm.Name, LocalPlayer.Name, 1, true) then
                    -- Formato: "Nombre - Arma" o "Nombre - Arma - algo"
                    local parts = string.split(vm.Name, " - ")
                    if #parts >= 2 then
                        name = parts[2]
                        break
                    end
                    -- Alternativa con match
                    local m = string.match(vm.Name, "^" .. LocalPlayer.Name .. "%s*%-%s*(.+)$")
                    if m then name = m break end
                end
            end
        end
    end)
    -- Fallback: Tool en character
    if not name then
        pcall(function()
            local char = LocalPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then name = tool.Name end
        end)
    end
    return name
end

local function applyNextSkin()
    if not Settings.SkinChanger then
        notify("YBTHU", "Activa Skin Changer primero", 2)
        return
    end
    local count = #availableSkins
    if count == 0 then count = collectSkins() end
    if count == 0 then
        notify("YBTHU", "No se encontraron skins (mira consola)", 3)
        return
    end
    currentSkinIndex = (currentSkinIndex % count) + 1
    local skin = availableSkins[currentSkinIndex]
    local weaponName = getCurrentEquippedWeapon()
    if weaponName and skin then
        if applySkinToWeapon(skin, weaponName) then
            notify("YBTHU", "Skin: " .. (skin.name or "?") .. " → " .. weaponName, 2)
            print("[YBTHU] Aplicada", skin.name, "de", skin.case, "en", weaponName)
        else
            notify("YBTHU", "No se pudo aplicar la skin", 2)
        end
    else
        notify("YBTHU", "Equipa un arma primero", 2)
        print("[YBTHU] Arma equipada detectada:", tostring(weaponName))
    end
end

local function setSkinChanger(on)
    Settings.SkinChanger = on
    if on then
        hideLocks()
        local n = collectSkins()
        if unlockConnection then pcall(function() unlockConnection:Disconnect() end) end
        local lastHide = 0
        unlockConnection = RunService.Heartbeat:Connect(function()
            if not Settings.SkinChanger then return end
            local now = tick()
            if now - lastHide < 0.5 then return end -- no escanear cada frame (causaba lag/crash)
            lastHide = now
            hideLocks()
        end)
        table.insert(allConnections, unlockConnection)
        notify("YBTHU", "Skin ON · " .. tostring(n) .. " skins · tecla = para ciclar", 3)
    else
        if unlockConnection then pcall(function() unlockConnection:Disconnect() end) end
        unlockConnection = nil
    end
end

safeConnect(UserInputService.InputBegan, function(input, gp)
    if gp or not running or not Settings.SkinChanger then return end
    if input.KeyCode == Enum.KeyCode.Equals then
        applyNextSkin()
    end
