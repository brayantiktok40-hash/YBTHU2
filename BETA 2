local function getPart(character)
    if not character then return nil end
    if Settings.Rage then
        return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
    end
    return character:FindFirstChild(Settings.TargetPart)
        or character:FindFirstChild("Head")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if Settings.IgnoreTeam and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end
    return isAlive(player.Character)
end

local function hasLineOfSight(fromPos, toPart, character)
    if Settings.Rage or not Settings.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { Camera }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function getPredictedPosition(part)
    if not part then return nil end
    local pred = Settings.Rage and (Settings.Prediction + 0.05) or Settings.Prediction
    if pred <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function()
        velocity = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    end)
    return part.Position + velocity * pred
end

local function getActiveFOV()
    return Settings.Rage and Settings.RageFOV or Settings.FOV
end

local currentTarget, stickyTarget = nil, nil
local aiming = false
local lastAutoFire = 0
local lastScan = 0
local targetRefreshRate = 0.06
local smoothedAimPosition = nil
local smoothedTarget = nil

local function getClosestTarget()
    local fov = getActiveFOV()
    local closest, closestDist = nil, fov
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position

    if Settings.StickyAim and stickyTarget and stickyTarget.Parent then
        local char = stickyTarget:FindFirstAncestorOfClass("Model") or stickyTarget.Parent
        local player = typeof(char) == "Instance" and char:IsA("Model") and Players:GetPlayerFromCharacter(char)
        local withinDistance = (camPos - stickyTarget.Position).Magnitude <= Settings.MaxDistance
        if player and withinDistance and isValidPlayer(player) then
            local sp, onScreen = Camera:WorldToViewportPoint(stickyTarget.Position)
            if onScreen and sp.Z > 0 then
                local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if dist <= fov * 1.35 and hasLineOfSight(camPos, stickyTarget, char) then
                    return stickyTarget
                end
            end
        end
        stickyTarget = nil
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if isValidPlayer(player) then
            local character = player.Character
            local part = getPart(character)
            if part then
                local worldDist = (camPos - part.Position).Magnitude
                if worldDist <= Settings.MaxDistance then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen and sp.Z > 0 then
                        local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if screenDist < closestDist and hasLineOfSight(camPos, part, character) then
                            closestDist = screenDist
                            closest = part
                        end
                    end
                end
            end
        end
    end

    stickyTarget = closest
    return closest
end

-- Auto fire SIN yield (nunca task.wait aquí)
local function doAutoFire()
    local now = tick()
    if now - lastAutoFire < Settings.AutoFireRate then return end
    lastAutoFire = now

    pcall(function()
        if typeof(mouse1click) == "function" then
            mouse1click()
            return
        end
        if typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
            mouse1press()
            mouse1release()
            return
        end
    end)
end

