local function killScript()
    if not running then return end
    running = false
    Settings.Aimbot = false
    Settings.SilentAim = false
    Settings.Rage = false
    Settings.ESP = false
    Settings.ShowFOV = false

    for _, conn in ipairs(allConnections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(allConnections)

    -- Quitar highlights
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then
                local h = p.Character:FindFirstChildOfClass("Highlight")
                if h then h:Destroy() end
            end
        end
    end)

    pcall(function()
        if fovGui then fovGui:Destroy() end
    end)
    pcall(function()
        local gui = getGuiParent()
        if gui then
            local old = gui:FindFirstChild("YBTHU_BETA2")
            if old then old:Destroy() end
        end
    end)

    notify("YBTHU", "Script apagado", 3)
    print("[YBTHU BETA 2] Script apagado correctamente")
end

