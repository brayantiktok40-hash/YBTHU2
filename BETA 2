    name.TextColor3 = Theme.Text
    name.Font = Enum.Font.GothamMedium
    name.TextSize = 13
    name.TextXAlignment = Enum.TextXAlignment.Left
    name.Parent = row
    labelRefs[labelKey] = name

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 48, 0, 24)
    toggle.Position = UDim2.new(1, -60, 0.5, -12)
    toggle.BackgroundColor3 = Settings[settingKey] and (onColor or Theme.On) or Theme.Off
    toggle.Text = ""
    toggle.Parent = row
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = Settings[settingKey] and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = toggle
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local function refresh()
        local on = Settings[settingKey]
        toggle.BackgroundColor3 = on and (onColor or Theme.On) or Theme.Off
        knob.Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
        name.Text = Texts[Settings.Language][labelKey]
    end

    toggle.MouseButton1Click:Connect(function()
        -- Evita que un mismo toque/clic genere dos eventos y apague Rage inmediatamente.
        if settingKey == "Rage" then
            local now = os.clock()
            if now - lastRageToggle < 0.25 then return end
            lastRageToggle = now
        end

        Settings[settingKey] = not Settings[settingKey]
        if settingKey == "ShowFOV" or settingKey == "Rage" then updateFOV() end
        if settingKey == "Rage" then
            notify("YBTHU", Settings.Rage and "Rage: Head + Auto Fire ON" or "Rage: OFF", 2)
        end
        refresh()
    end)

    toggleRefs[settingKey] = refresh
    refresh()
end

