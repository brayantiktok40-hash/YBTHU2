end

local function isAlive(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

local function isValidPlayer(player)
    if player == LocalPlayer then return false end
    if not isAlive(player.Character) then return false end

    -- 1) Ignore Friends (soluciona "se pega a mi amigo")
    if Settings.IgnoreFriends then
        local ok, isFriend = pcall(function()
            return LocalPlayer:IsFriendsWith(player.UserId)
        end)
        if ok and isFriend then
            return false
        end
    end

    -- 2) Ignore Team (multiples metodos para Rivals)
    if Settings.IgnoreTeam then
        -- Metodo A: Team object de Roblox
        local myTeam = LocalPlayer.Team
        local theirTeam = player.Team
        if myTeam and theirTeam and myTeam == theirTeam then
            return false
        end

        -- Metodo B: TeamColor (solo si ambos tienen Team)
        if myTeam and theirTeam and player.TeamColor and LocalPlayer.TeamColor then
            if player.TeamColor == LocalPlayer.TeamColor then
                return false
            end
        end

        -- Metodo C: Attributes comunes en juegos FPS
        local char = player.Character
        if char then
            local attrNames = {"Team", "team", "Faction", "Side", "Alliance", "Group"}
            for _, attr in ipairs(attrNames) do
                local myAttr = LocalPlayer:GetAttribute(attr) or (LocalPlayer.Character and LocalPlayer.Character:GetAttribute(attr))
                local theirAttr = player:GetAttribute(attr) or char:GetAttribute(attr)
                if myAttr ~= nil and theirAttr ~= nil and myAttr == theirAttr then
                    return false
                end
            end
        end

        -- Metodo D: StringValue / IntValue llamado Team dentro del player o character
        local sameTeamValue = false
        pcall(function()
            local function findTeamValue(parent)
                if not parent then return nil end
                local v = parent:FindFirstChild("Team") or parent:FindFirstChild("team")
                if v and (v:IsA("StringValue") or v:IsA("IntValue") or v:IsA("NumberValue")) then
                    return v.Value
                end
                return nil
            end
            local myVal = findTeamValue(LocalPlayer) or findTeamValue(LocalPlayer.Character)
            local theirVal = findTeamValue(player) or findTeamValue(player.Character)
            if myVal ~= nil and theirVal ~= nil and myVal == theirVal then
                sameTeamValue = true
            end
        end)
        if sameTeamValue then return false end
    end

    return true
end

local function hasLineOfSight(fromPos, toPart, character)
    if Settings.Rage or not Settings.WallCheck then return true end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { Camera }
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(filter, p.Character) end
    end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(fromPos, toPart.Position - fromPos, params)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function getPredictedPosition(part)
    if not part then return nil end
    local pred = Settings.Rage and (Settings.Prediction + 0.16) or Settings.Prediction
    if pred <= 0 then return part.Position end
    local velocity = Vector3.zero
    pcall(function()
        local char = part.Parent
        local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        local src = root or part
        velocity = src.AssemblyLinearVelocity or src.Velocity or Vector3.zero
        -- Si la velocidad es casi 0, intentar con Humanoid MoveDirection
        if velocity.Magnitude < 0.5 and char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.MoveDirection.Magnitude > 0.1 then
                velocity = hum.MoveDirection * (hum.WalkSpeed or 16)
            end
        end
    end)
    -- Menos prediccion vertical (salta menos el aim)
    return part.Position + Vector3.new(velocity.X, velocity.Y * 0.2, velocity.Z) * pred
end

