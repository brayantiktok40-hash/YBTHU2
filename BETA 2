-- Aim principal + Hard Guard
safeConnect(RunService.RenderStepped, function(dt)
    if not running then return end
    -- Camara fija durante wallbang (body se mueve, tu vista no)
    if pbBusy then
        keepPointBlankCamera()
        if tick() >= pbUntil then
            restorePointBlank()
        end
    end

    if not Settings.Aimbot and not Settings.SilentAim and not Settings.Rage then
        currentTarget = nil
        stickyTarget = nil
        smoothedTarget = nil
        smoothedAimPosition = nil
        silentAimPos = nil
        aiming = false
        return
    end

    local mouseHeld = isAimHeld()
    local mouse1Held = isM1Held()
    if Settings.Rage and Settings.RageWallbang and mouse1Held then
        pcall(doPointBlankWallbang)
    end

    -- Rage: siempre activo. Silent: rastrea. Aimbot: con tecla.
    local shouldAim = Settings.Rage
        or Settings.SilentAim
        or (Settings.Aimbot and (aiming or mouseHeld))
    if not shouldAim then return end
    if not passHitChance() then return end

    local now = os.clock()
    local refresh = Settings.Rage and 0.018 or (Settings.TargetRefresh or 0.055)
    if now - lastScan >= refresh or not currentTarget or not currentTarget.Parent then
        lastScan = now
        local nextTarget = getClosestTarget()
        if nextTarget ~= currentTarget then smoothedAimPosition = nil end
        currentTarget = nextTarget
    end

    if not currentTarget or not currentTarget.Parent then
        stickyTarget = nil
        smoothedTarget = nil
        smoothedAimPosition = nil
        silentAimPos = nil
        return
    end

    local targetPos = getPredictedPosition(currentTarget)
    if not targetPos then return end

    if smoothedTarget ~= currentTarget or not smoothedAimPosition then
        smoothedTarget = currentTarget
        smoothedAimPosition = targetPos
    else
        local follow = Settings.Rage and (dt * 14) or (dt * 8)
        smoothedAimPosition = smoothedAimPosition:Lerp(targetPos, math.clamp(follow, 0.15, 0.42))
    end
    silentAimPos = smoothedAimPosition

    if not (Settings.Aimbot or Settings.Rage) then return end

    local alpha = Settings.Rage and Settings.RageSmoothness or Settings.Smoothness
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local screenPoint, onScreen = Camera:WorldToViewportPoint(smoothedAimPosition)
    local screenOffset = 9999
    if onScreen and screenPoint.Z > 0 then
        local dx = screenPoint.X - screenCenter.X
        local dy = screenPoint.Y - screenCenter.Y
        screenOffset = math.sqrt(dx * dx + dy * dy)
    end

    -- ===================== RAGE =====================
    if Settings.Rage then
        -- Durante wallbang: NO mover camara (ya esta congelada), pero seguir trackeando
        if pbBusy then
            keepPointBlankCamera()
            return
        end
        -- Camera lock: instantaneo + mouse move (Real a veces pisa CFrame)
        if Settings.RageCameraLock then
            pcall(function()
                local look = CFrame.lookAt(Camera.CFrame.Position, smoothedAimPosition)
                Camera.CFrame = look
            end)
            -- Refuerzo con mousemoverel por si el juego resetea la camara
            if onScreen and screenPoint.Z > 0 and screenOffset > 3 then
                local dx = screenPoint.X - screenCenter.X
                local dy = screenPoint.Y - screenCenter.Y
                local strength = 0.65
                local maxStep = 80
                local moveX = math.clamp(dx * strength, -maxStep, maxStep)
                local moveY = math.clamp(dy * strength, -maxStep, maxStep)
                if typeof(mousemoverel) == "function" then
                    pcall(mousemoverel, moveX, moveY)
                end
            end
        else
            -- Sin camera lock: mouse mas agresivo pero controlado
            if onScreen and screenPoint.Z > 0 and screenOffset > 2.5 then
                local dx = screenPoint.X - screenCenter.X
                local dy = screenPoint.Y - screenCenter.Y
                local strength = (screenOffset > 80) and 0.55 or 0.28
                local maxStep = 55
                local moveX = math.clamp(dx * strength, -maxStep, maxStep)
                local moveY = math.clamp(dy * strength, -maxStep, maxStep)
                if typeof(mousemoverel) == "function" then
                    mousemoverel(moveX, moveY)
                elseif typeof(Input) == "table" and typeof(Input.MouseMove) == "function" then
                    Input.MouseMove(moveX, moveY)
                end
            end
        end
        return
    end

    -- ===================== AIMBOT NORMAL =====================
    if onScreen and screenPoint.Z > 0 then
        local deltaX = screenPoint.X - screenCenter.X
        local deltaY = screenPoint.Y - screenCenter.Y
        local deadzone = Settings.AimDeadzone

        if screenOffset > deadzone then
            local alphaClamped = math.clamp(alpha, 0.05, 0.95)
            local frameAlpha = 1 - math.pow(1 - alphaClamped, math.clamp(dt * 60, 0.4, 1.4))
            local accel = Settings.MouseAccel or 1.0

            local distFactor
            if screenOffset > 150 then
                distFactor = 1.0
            elseif screenOffset > 50 then
                distFactor = 0.75
            else
                distFactor = 0.45
            end

            local strength = frameAlpha * distFactor * accel
            local maxStep = 32
            local moveX = math.clamp(deltaX * strength, -maxStep, maxStep)
            local moveY = math.clamp(deltaY * strength, -maxStep, maxStep)

            local moved = false
            if typeof(mousemoverel) == "function" then
                mousemoverel(moveX, moveY)
                moved = true
            elseif typeof(Input) == "table" and typeof(Input.MouseMove) == "function" then
                Input.MouseMove(moveX, moveY)
                moved = true
            elseif typeof(mouse1move) == "function" then
                pcall(mouse1move, moveX, moveY)
                moved = true
            end
            if not moved then
                pcall(function()
                    local look = CFrame.lookAt(Camera.CFrame.Position, smoothedAimPosition)
                    Camera.CFrame = Camera.CFrame:Lerp(look, math.clamp(alpha * 0.6, 0.15, 0.55))
                end)
            end
        end
    end
end)

