local tracked = {}

local function refreshESP()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            table.insert(list, p.Character)
        end
    end
    tracked = list
end

task.spawn(function()
    while task.wait(1.5) do refreshESP() end
end)

RunService.Heartbeat:Connect(function()
    if not Settings.ESP then return end
    local color = Settings.ESPColors[Settings.ColorIndex]
    for _, model in pairs(tracked) do
        if model and model.Parent and isAlive(model) then
            local h = model:FindFirstChildOfClass("Highlight")
            if not h then
                h = Instance.new("Highlight")
                h.Parent = model
                h.FillTransparency = 0.55
                h.OutlineTransparency = 0.2
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end
            h.Enabled = true
            h.FillColor = color
            h.OutlineColor = color
        end
    end
end)

task.spawn(function()
    while task.wait(1) do
        if not Settings.ESP then
            for _, model in pairs(tracked) do
                if model and model.Parent then
                    local h = model:FindFirstChildOfClass("Highlight")
                    if h then h.Enabled = false end
                end
            end
        end
    end
end)

