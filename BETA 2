            currentTarget = nil
            stickyTarget = nil
            smoothedTarget = nil
            smoothedAimPosition = nil
        end
    end
end)

-- UN solo loop de aim (ligero)
safeConnect(RunService.RenderStepped, function(dt)
    if not running then return end
    local mouseHeld = false
    pcall(function()
        mouseHeld = UserInputService:IsMouseButtonPressed(Settings.AimKey)
    end)
    local shouldAim = Settings.Rage or ((Settings.Aimbot or Settings.SilentAim) and (aiming or mouseHeld))
    if not shouldAim then return end
    if not Settings.Aimbot and not Settings.SilentAim and not Settings.Rage then return end

    local now = os.clock()
    if now - lastScan >= targetRefreshRate or not currentTarget or not currentTarget.Parent then
        lastScan = now
        local nextTarget = getClosestTarget()
        if nextTarget ~= currentTarget then
            smoothedAimPosition = nil
        end
        currentTarget = nextTarget
    end

    if not currentTarget or not currentTarget.Parent then
        stickyTarget = nil
        smoothedTarget = nil
        smoothedAimPosition = nil
        return
    end

    local targetPos = getPredictedPosition(currentTarget)
    if not targetPos then return end

    if smoothedTarget ~= currentTarget or not smoothedAimPosition then
        smoothedTarget = currentTarget
        smoothedAimPosition = targetPos
    else
        smoothedAimPosition = smoothedAimPosition:Lerp(targetPos, math.clamp(dt * 8, 0.08, 0.35))
    end

    local alpha
    if Settings.Rage then
        alpha = Settings.RageSmoothness
    elseif Settings.SilentAim and not Settings.Aimbot then
        alpha = 0.9
    elseif Settings.SilentAim then
        alpha = Settings.SilentSmoothness
    else
        alpha = Settings.Smoothness
    end

    -- Aimbot / Rage: mueve el MOUSE (no la cámara)
    if Settings.Aimbot or Settings.Rage then
        local screenPoint, onScreen = Camera:WorldToViewportPoint(smoothedAimPosition)
        if onScreen and screenPoint.Z > 0 then
            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            local deltaX = screenPoint.X - screenCenter.X
            local deltaY = screenPoint.Y - screenCenter.Y
            local screenOffset = math.sqrt(deltaX * deltaX + deltaY * deltaY)

            -- Deadzone para que no tiemble
            if screenOffset > Settings.AimDeadzone then
                local frameAlpha = 1 - math.pow(1 - math.clamp(alpha, 0.05, 1), math.clamp(dt * 60, 0.5, 2.2))
                local moveX = deltaX * frameAlpha
                local moveY = deltaY * frameAlpha

                if typeof(mousemoverel) == "function" then
                    mousemoverel(moveX, moveY)
                elseif typeof(Input) == "table" and typeof(Input.MouseMove) == "function" then
                    Input.MouseMove(moveX, moveY)
                end
            end
        end
    end

    -- Rage auto fire (sin wait)
    if Settings.Rage then
        doAutoFire()
    end
end)

